<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <!-- Versions are pinned centrally so every project agrees.
       Bump deliberately, one package per PR, with a note in docs/adr/. -->
  <ItemGroup Label="Data">
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.0" />
    <!-- ".Core" on purpose: the plain Microsoft.EntityFrameworkCore.Sqlite package drags in
         SQLitePCLRaw.bundle_e_sqlite3, whose native library has no SQLCipher support and
         would silently ignore PRAGMA key, leaving the database unencrypted (NFR-S3).
         The bundle also carries a known advisory (GHSA-2m69-gcr7-jv3q). See docs/adr/0003. -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite.Core" Version="10.0.0" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.0" />
    <PackageVersion Include="Microsoft.Data.Sqlite.Core" Version="10.0.0" />
    <PackageVersion Include="SQLitePCLRaw.bundle_e_sqlcipher" Version="2.1.10" />
    <PackageVersion Include="Dapper" Version="2.1.66" />
  </ItemGroup>

  <ItemGroup Label="Hosting">
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Json" Version="10.0.0" />
    <PackageVersion Include="Serilog.Extensions.Hosting" Version="9.0.0" />
    <PackageVersion Include="Serilog.Sinks.File" Version="6.0.0" />
  </ItemGroup>

  <ItemGroup Label="UI">
    <PackageVersion Include="Avalonia" Version="11.2.3" />
    <PackageVersion Include="Avalonia.Desktop" Version="11.2.3" />
    <PackageVersion Include="Avalonia.Themes.Fluent" Version="11.2.3" />
    <PackageVersion Include="Avalonia.Diagnostics" Version="11.2.3" />
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <!-- Transitive, via Avalonia.Desktop's X11 backend (Linux dev/CI only).
         Avalonia 11.2.3 pulls 0.20.0, which carries GHSA-xrw6-gwf8-vvr9 (CVE-2026-39959).
         Pinned forward to 0.21.3, the fix on that line; CentralPackageTransitivePinningEnabled
         makes this stick. Remove when Avalonia's own floor moves past it. -->
    <PackageVersion Include="Tmds.DBus.Protocol" Version="0.21.3" />
  </ItemGroup>

  <ItemGroup Label="Documents and devices">
    <PackageVersion Include="QuestPDF" Version="2024.12.3" />
    <PackageVersion Include="ClosedXML" Version="0.104.2" />
    <PackageVersion Include="CsvHelper" Version="33.0.1" />
    <PackageVersion Include="ZXing.Net" Version="0.16.9" />
    <PackageVersion Include="Scriban" Version="5.12.0" />
    <PackageVersion Include="System.IO.Ports" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup Label="Security and backup">
    <PackageVersion Include="Konscious.Security.Cryptography.Argon2" Version="1.3.1" />
    <PackageVersion Include="System.Security.Cryptography.ProtectedData" Version="10.0.0" />
    <PackageVersion Include="ZstdSharp.Port" Version="0.8.5" />
  </ItemGroup>

  <ItemGroup Label="Testing">
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.0.1" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageVersion Include="FluentAssertions" Version="7.0.0" />
    <PackageVersion Include="Verify.Xunit" Version="28.4.0" />
    <PackageVersion Include="Bogus" Version="35.6.1" />
    <PackageVersion Include="BenchmarkDotNet" Version="0.14.0" />
    <PackageVersion Include="FsCheck.Xunit" Version="3.0.0" />
  </ItemGroup>
</Project>
