root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{json,yml,yaml,md,csproj,props,targets,xml,axaml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.cs]
dotnet_sort_system_directives_first = true
csharp_using_directive_placement = outside_namespace:warning
csharp_style_namespace_declarations = file_scoped:warning
csharp_prefer_braces = true:warning
csharp_style_var_when_type_is_apparent = true:suggestion
dotnet_style_readonly_field = true:warning
dotnet_style_require_accessibility_modifiers = always:warning

# Nullability and correctness are errors, not suggestions.
dotnet_diagnostic.CS8600.severity = error
dotnet_diagnostic.CS8602.severity = error
dotnet_diagnostic.CS8618.severity = error

# Money must be culture-invariant when formatted for storage or receipts.
dotnet_diagnostic.CA1305.severity = error

# Async correctness
dotnet_diagnostic.CA2007.severity = none
dotnet_diagnostic.VSTHRD200.severity = none

[tests/**/*.cs]
dotnet_diagnostic.CA1305.severity = suggestion

# Test names carry requirement ids and read as sentences:
# FR_2_4_BoxToPieceConversion, AC03_PartialReturnRefundsAtOriginalPrice
# (docs/00_ENGINEERING_GUIDE.md §6). Underscores are the convention here, not an accident.
dotnet_diagnostic.CA1707.severity = none
