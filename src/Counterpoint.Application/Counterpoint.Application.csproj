    adapter. Version comes from Directory.Packages.props. See docs/adr/0007.
  -->
  <ItemGroup>
    <PackageReference Include="Konscious.Security.Cryptography.Argon2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Counterpoint.Domain\Counterpoint.Domain.csproj" />
  </ItemGroup>

</Project>
