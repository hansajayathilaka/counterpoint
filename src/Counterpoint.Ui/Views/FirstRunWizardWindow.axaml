<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Counterpoint.Ui.ViewModels.FirstRun"
        xmlns:views="using:Counterpoint.Ui.Views.Settings"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="860" d:DesignHeight="620"
        x:Class="Counterpoint.Ui.Views.FirstRunWizardWindow"
        x:DataType="vm:FirstRunWizardViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Width="860" Height="620"
        WindowStartupLocation="CenterScreen"
        Title="Counterpoint - first-run setup">

  <!--
    Seven pages, and nothing is written until the last one: the whole setup is a single
    transaction in the Application layer. Keyboard first (UI-01) - Enter moves on, Escape
    goes back, and the pages reuse the very same controls the settings screen uses.
  -->
  <Window.KeyBindings>
    <KeyBinding Gesture="Enter" Command="{Binding NextCommand}" />
    <KeyBinding Gesture="Escape" Command="{Binding BackCommand}" />
    <KeyBinding Gesture="Ctrl+Enter" Command="{Binding FinishCommand}" />
  </Window.KeyBindings>

  <DockPanel Margin="16">

    <StackPanel DockPanel.Dock="Top" Spacing="4">
      <TextBlock FontSize="22" Text="Setting up this till" />
      <TextBlock FontSize="16" Text="{Binding CurrentStepHeading}" />
    </StackPanel>

    <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0" Spacing="6">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Content="_Back (Esc)" Command="{Binding BackCommand}" IsEnabled="{Binding CanGoBack}" />
        <Button Content="_Next (Enter)" Command="{Binding NextCommand}" IsVisible="{Binding !IsLastStep}" />
        <Button Content="_Finish setup" Command="{Binding FinishCommand}"
                IsVisible="{Binding IsLastStep}" IsEnabled="{Binding !Busy}" />
      </StackPanel>
      <TextBlock TextWrapping="Wrap" Text="{Binding Status}" />
    </StackPanel>

    <Carousel SelectedIndex="{Binding StepIndex}">

      <!-- 1. Shop profile (FR-10.1). -->
      <views:ShopProfileSettingsView DataContext="{Binding Shop}" />

      <!-- 2. Currency, decimals and rounding (FR-10.2). -->
      <views:FinancialSettingsView DataContext="{Binding Financial}" />

      <!-- 3. Tax classes (FR-10.3). Each row becomes a tax_class the catalogue can use. -->
      <ScrollViewer>
        <StackPanel Margin="12" Spacing="8">
          <views:TaxSettingsView DataContext="{Binding Tax}" />

          <TextBlock FontSize="16" Text="Tax classes to create" />
          <ItemsControl ItemsSource="{Binding TaxClasses}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:TaxClassEntryViewModel">
                <Grid ColumnDefinitions="240,100,Auto" Margin="0,0,0,4">
                  <TextBox Grid.Column="0" Watermark="Name" Text="{Binding Name}" />
                  <TextBox Grid.Column="1" Margin="8,0,0,0" Watermark="Rate %" Text="{Binding Rate}" />
                  <Button Grid.Column="2" Margin="8,0,0,0" Content="Remove"
                          Command="{Binding $parent[Window].((vm:FirstRunWizardViewModel)DataContext).RemoveTaxClassCommand}"
                          CommandParameter="{Binding}" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <Button Content="_Add another tax class" HorizontalAlignment="Left"
                  Command="{Binding AddTaxClassCommand}" />
        </StackPanel>
      </ScrollViewer>

      <!-- 4. Bill number format (FR-10.4). -->
      <StackPanel Margin="12" Spacing="8">
        <TextBlock TextWrapping="Wrap"
                   Text="How bills are numbered. The other series keep their usual format and can be changed later in Settings." />
        <views:DocumentNumberingView DataContext="{Binding BillNumbering}" />
      </StackPanel>

      <!-- 5. Receipt printer (FR-10.6). Named, not discovered - see PeripheralSettingsViewModel. -->
      <StackPanel Margin="12" Spacing="6">
        <TextBlock TextWrapping="Wrap"
                   Text="Which printer bills come out of. Leave it empty for now if the printer has not been set up yet - bills will be written to a file and nothing will be lost." />
        <TextBlock Text="Receipt printer queue name" />
        <TextBox Width="320" HorizontalAlignment="Left"
                 Text="{Binding Peripherals.ReceiptPrinterName}" />
        <TextBlock Text="Paper width, in millimetres" />
        <TextBox Width="100" HorizontalAlignment="Left" Text="{Binding Peripherals.PaperWidthMm}" />
      </StackPanel>

      <!-- 6. Owner account (FR-1.3). The account exists; this gives it its first password. -->
      <StackPanel Margin="12" Spacing="6">
        <TextBlock TextWrapping="Wrap"
                   Text="The owner's account already exists on this till but has no password yet. There is no default password anywhere in this system." />
        <TextBlock Text="Owner username" />
        <TextBox Width="240" HorizontalAlignment="Left" Text="{Binding OwnerUsername}" />
        <TextBlock Text="Password" />
        <TextBox Width="240" HorizontalAlignment="Left" PasswordChar="•"
                 Text="{Binding OwnerPassword}" />
        <TextBlock Text="Type it again" />
        <TextBox Width="240" HorizontalAlignment="Left" PasswordChar="•"
                 Text="{Binding ConfirmOwnerPassword}" />
      </StackPanel>

      <!-- 7. Backup folder and passphrase (FR-10.7, FR-11.4). -->
      <views:BackupSettingsView DataContext="{Binding Backup}" />

    </Carousel>

  </DockPanel>

</Window>
