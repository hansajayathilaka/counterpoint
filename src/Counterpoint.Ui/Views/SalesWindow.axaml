<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Counterpoint.Ui.ViewModels"
        xmlns:views="using:Counterpoint.Ui.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="720"
        x:Class="Counterpoint.Ui.Views.SalesWindow"
        x:DataType="vm:SalesViewModel"
        Width="1280" Height="720" MinWidth="1024" MinHeight="640"
        FontSize="16"
        Icon="/Assets/avalonia-logo.ico"
        Background="{DynamicResource WindowBackgroundBrush}"
        Title="Counterpoint - Sales">

  <!--
    SRS UI-01: fully keyboard and scanner operable, the mouse optional throughout. Every
    function key of UI-02 is a Window-level KeyBinding, so it fires no matter which control
    inside the window has focus - the same reason the scanner burst filter in the code-behind
    intercepts at the Window, not at the scan box (P1-T09 "Do this" #4).
  -->
  <Window.KeyBindings>
    <KeyBinding Gesture="F1" Command="{Binding HelpCommand}" />
    <KeyBinding Gesture="F2" Command="{Binding NewSaleCommand}" />
    <KeyBinding Gesture="F3" Command="{Binding SearchCommand}" />
    <KeyBinding Gesture="F4" Command="{Binding ReturnCommand}" />
    <KeyBinding Gesture="F5" Command="{Binding HoldCommand}" />
    <KeyBinding Gesture="F6" Command="{Binding RecallCommand}" />
    <KeyBinding Gesture="F7" Command="{Binding DiscountCommand}" />
    <KeyBinding Gesture="F8" Command="{Binding CustomerCommand}" />
    <KeyBinding Gesture="F9" Command="{Binding PayCommand}" />
    <KeyBinding Gesture="F10" Command="{Binding ReprintCommand}" />
    <KeyBinding Gesture="F11" Command="{Binding StockCommand}" />
    <KeyBinding Gesture="F12" Command="{Binding DayCloseCommand}" />
    <KeyBinding Gesture="Escape" Command="{Binding CancelCommand}" />
  </Window.KeyBindings>

  <DockPanel>

    <!-- SRS UI-09: user, shift, backup, cloud and printer status, permanently visible. -->
    <Border DockPanel.Dock="Top" Background="{DynamicResource PanelBackgroundBrush}" Padding="10,4">
      <StackPanel Orientation="Horizontal" Spacing="18">
        <TextBlock Text="{Binding StatusUserText}" Foreground="{DynamicResource PrimaryTextBrush}" />
        <TextBlock Text="{Binding StatusShiftText}" Foreground="{DynamicResource PrimaryTextBrush}" />
        <TextBlock Text="{Binding StatusBackupText}" Foreground="{DynamicResource PrimaryTextBrush}" />
        <TextBlock Text="{Binding StatusCloudText}" Foreground="{DynamicResource PrimaryTextBrush}" />
        <TextBlock Text="{Binding StatusPrinterText}" Foreground="{DynamicResource PrimaryTextBrush}" />
        <TextBlock Text="{Binding StatusPrintQueueText}" Foreground="{DynamicResource PrimaryTextBrush}" />
      </StackPanel>
    </Border>

    <!-- The status line for whatever just happened, plus the button row for screens reached the same way the walking-skeleton screen already offered them. -->
    <StackPanel DockPanel.Dock="Bottom" Margin="10,4" Spacing="4">
      <TextBlock TextWrapping="Wrap" Text="{Binding Status}" FontSize="15" />
      <StackPanel Orientation="Horizontal" Spacing="10">
        <!-- Task P3-T13, SRS UI-11: Catalogue/Settings/Users/Purchasing/Labels moved behind this
             one entry point, into their own back-office shell, visually distinct from this
             screen. Hiding this button is a courtesy, not the control (SRS NFR-S2, AC-17,
             AC-24) - every screen behind it re-checks the session's role at the Application
             layer regardless of whether this button was ever shown. -->
        <Button Content="_Back office" Command="{Binding OpenBackOfficeCommand}" IsVisible="{Binding CanOpenBackOffice}" FontWeight="Bold" />
        <Button Content="_Print queue" Command="{Binding OpenPrintQueueCommand}" />
        <Button Content="Open item" Command="{Binding OpenItemCommand}" />
        <!-- SRS FR-8.1: shown only while the till has no open shift to trade in. -->
        <Button Content="Open shift" Command="{Binding OpenShiftCommand}" IsVisible="{Binding CanOpenShift}" FontWeight="Bold" />
        <!-- SRS FR-9.7: the compact home-screen dashboard. -->
        <Button Content="Dashboard" Command="{Binding DashboardCommand}" />
      </StackPanel>
    </StackPanel>

    <!-- SRS UI-02: fixed, visible function keys, exactly as printed on the quick-reference card. -->
    <UniformGrid DockPanel.Dock="Bottom" Columns="13" Margin="10,0">
      <Button Content="F1 Help" Command="{Binding HelpCommand}" />
      <Button Content="F2 New" Command="{Binding NewSaleCommand}" />
      <Button Content="F3 Search" Command="{Binding SearchCommand}" />
      <Button Content="F4 Return" Command="{Binding ReturnCommand}" />
      <Button Content="F5 Hold" Command="{Binding HoldCommand}" />
      <Button Content="F6 Recall" Command="{Binding RecallCommand}" />
      <Button Content="F7 Discount" Command="{Binding DiscountCommand}" />
      <Button Content="F8 Customer" Command="{Binding CustomerCommand}" />
      <Button Content="F9 Pay" Command="{Binding PayCommand}" IsEnabled="{Binding !Busy}" FontWeight="Bold" />
      <Button Content="F10 Reprint" Command="{Binding ReprintCommand}" />
      <Button Content="F11 Stock" Command="{Binding StockCommand}" />
      <Button Content="F12 Day close" Command="{Binding DayCloseCommand}" />
      <Button Content="Esc Cancel" Command="{Binding CancelCommand}" />
    </UniformGrid>

    <!-- Everything between the status bar and the function keys: scan box, lines, total on the
         left; whichever non-modal panel is open on the right (SRS UI-01: non-modal, so a scan
         still lands on the bill even while one of these has focus). -->
    <Grid ColumnDefinitions="*,Auto" Margin="10">

      <DockPanel Grid.Column="0">

        <!-- SRS FR-3.1: the cursor starts here; the code-behind also gives it focus on load and
             after every scan. -->
        <TextBox DockPanel.Dock="Top"
                 Name="ScanBox"
                 FontSize="20"
                 Watermark="Scan or type a barcode, then press Enter"
                 Text="{Binding Barcode}">
          <TextBox.KeyBindings>
            <KeyBinding Gesture="Enter" Command="{Binding ScanCommand}" />
          </TextBox.KeyBindings>
        </TextBox>

        <!-- SRS UI-03: the running total is the most prominent element on the screen. -->
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource PanelBackgroundBrush}" Margin="0,10,0,0" Padding="16">
          <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto" VerticalAlignment="Center">
            <TextBlock Grid.Column="0" Text="{Binding CurrentCustomerText}" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Margin="16,0" HorizontalAlignment="Right">
              <TextBlock Text="Subtotal" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="13" HorizontalAlignment="Right" />
              <TextBlock Text="{Binding SubtotalText}" Foreground="{DynamicResource PrimaryTextBrush}" HorizontalAlignment="Right" />
            </StackPanel>
            <StackPanel Grid.Column="2" Margin="16,0" HorizontalAlignment="Right" IsVisible="{Binding HasBillDiscount}">
              <TextBlock Text="Discount" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="13" HorizontalAlignment="Right" />
              <TextBlock Text="{Binding BillDiscountText}" Foreground="{DynamicResource WarningBrush}" HorizontalAlignment="Right" />
            </StackPanel>
            <StackPanel Grid.Column="3" Margin="16,0" HorizontalAlignment="Right">
              <TextBlock Text="Tax" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="13" HorizontalAlignment="Right" />
              <TextBlock Text="{Binding TaxText}" Foreground="{DynamicResource PrimaryTextBrush}" HorizontalAlignment="Right" />
            </StackPanel>
            <StackPanel Grid.Column="4" Margin="16,0,0,0" HorizontalAlignment="Right">
              <TextBlock Text="TOTAL" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="15" HorizontalAlignment="Right" />
              <TextBlock Text="{Binding Total}" Foreground="{DynamicResource TotalHighlightBrush}" FontSize="44" FontWeight="Bold" HorizontalAlignment="Right" />
            </StackPanel>
          </Grid>
        </Border>

        <!-- The bill lines. Quantity and unit are editable inline (SRS FR-3.5, FR-2.5, FR-3.7);
             the price is never typed directly onto a catalogue line (FR-3.19 is owner-only and
             this task builds no override dialog). -->
        <ListBox Margin="0,10,0,10"
                 ItemsSource="{Binding Lines}"
                 SelectedItem="{Binding SelectedLine}">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:SaleLineViewModel">
              <Grid ColumnDefinitions="*,90,80,90,90,90,Auto" Margin="0,2">
                <TextBlock Grid.Column="0" Text="{Binding Description}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <TextBox Grid.Column="1" Text="{Binding QuantityText}" Margin="4,0">
                  <TextBox.KeyBindings>
                    <KeyBinding Gesture="Enter" Command="{Binding CommitQuantityCommand}" />
                  </TextBox.KeyBindings>
                </TextBox>
                <ComboBox Grid.Column="2" Margin="4,0"
                          IsVisible="{Binding CanSwitchUnit}"
                          ItemsSource="{Binding UnitChoices}"
                          SelectedItem="{Binding SelectedUnitSymbol}" />
                <TextBlock Grid.Column="3" Text="{Binding UnitPriceText}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                <TextBlock Grid.Column="4" Text="{Binding DiscountText}" Foreground="{DynamicResource WarningBrush}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                <TextBlock Grid.Column="5" Text="{Binding LineTotalText}" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Right" />
                <Button Grid.Column="6" Content="✕" Margin="4,0,0,0" Command="{Binding RemoveCommand}" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

      </DockPanel>

      <!-- The one non-modal side panel open at a time (SRS UI-01). A scan still lands on the
           bill while one of these has focus - the code-behind's scanner filter intercepts at
           the Window, regardless of which of these has focus. Extracted into its own view
           (task P3-T14) so Counterpoint.Ui.Tests.Support.ViewLabelInspector can open it
           directly - see SalesSidePanelView.axaml's own remarks. -->
      <views:SalesSidePanelView Grid.Column="1" />

    </Grid>

  </DockPanel>

</Window>
