<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Counterpoint.Ui.ViewModels"
             xmlns:conv="clr-namespace:Avalonia.Data.Converters;assembly=Avalonia.Base"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="220" d:DesignHeight="640"
             x:Class="Counterpoint.Ui.Views.NavRail"
             x:DataType="vm:BackOfficeShellViewModel"
             Width="220">

  <!--
    Task P3-T18 (SRS UI-11, UI-16, NFR-S2, AC-24), extended by task P3-T19. Replaces
    BackOfficeShellWindow's old flat UniformGrid of five tiles with a persistent, grouped rail,
    drawn from the P3-T17 rail sub-palette (RailBackgroundBrush et al.) - never a raw hex literal.
    Every group below is gated by exactly the Can* flag the equivalent tile used before task
    P3-T18 (see BackOfficeShellViewModel's own remarks for the full mapping).

    Keyboard-first (UI-01, task P3-T18's own named risk): Trading/People stay plain Buttons, and
    System's own nine sub-items (since task P3-T19) are ToggleButtons - both exactly as
    keyboard-operable via Tab+Enter/Space as the tile buttons they replace always were. Catalogue's
    eight destinations are a ListBox instead - the only group that is - because a ListBox's native
    Up/Down-arrow
    selection is what actually replicates the TabControl keyboard behaviour CatalogueWindow's own
    TabControl used to provide (arrowing between tabs swaps content immediately); System's nine
    stay plain ToggleButtons rather than a second ListBox deliberately, so this rail keeps exactly
    one ListBox (NavRailKeyboardNavigationTests' own `.Single()` lookup) and System's own keyboard
    reach (Tab+Enter/Space) matches what Trading/People already offered before this task, with no
    regression either way.
  -->
  <Border Background="{DynamicResource RailBackgroundBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="0,16,0,16" Spacing="20">

        <!-- Overview (pending P3-T20's real dashboard content) -->
        <StackPanel Spacing="4">
          <TextBlock Text="OVERVIEW" Margin="16,0" FontSize="11" FontWeight="Bold"
                     Foreground="{DynamicResource RailMutedTextBrush}" />
          <ToggleButton Content="Overview"
                        Command="{Binding SelectOverviewCommand}"
                        IsChecked="{Binding IsOverviewActive}"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                        Padding="16,10" Background="Transparent" BorderThickness="0"
                        Foreground="{DynamicResource RailTextBrush}" />
        </StackPanel>

        <!-- Catalogue: eight content-pane-swapping entries, folded in by task P3-T18 -->
        <StackPanel Spacing="4" IsVisible="{Binding CanManageCatalogue}">
          <TextBlock Text="CATALOGUE" Margin="16,0" FontSize="11" FontWeight="Bold"
                     Foreground="{DynamicResource RailMutedTextBrush}" />
          <ListBox x:Name="CatalogueList"
                   ItemsSource="{Binding CatalogueSections}"
                   SelectedItem="{Binding SelectedCatalogueSection, Mode=TwoWay}"
                   Focusable="True"
                   Background="Transparent"
                   Foreground="{DynamicResource RailTextBrush}" />
        </StackPanel>

        <!-- Trading: unchanged from task P3-T13, still opening the same windows outright -->
        <StackPanel Spacing="4" IsVisible="{Binding CanSeeTradingGroup}">
          <TextBlock Text="TRADING" Margin="16,0" FontSize="11" FontWeight="Bold"
                     Foreground="{DynamicResource RailMutedTextBrush}" />
          <Button Content="Purchase orders" Command="{Binding ManagePurchaseOrdersCommand}"
                  IsVisible="{Binding CanManagePurchasing}"
                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                  Padding="16,10" Background="Transparent" BorderThickness="0"
                  Foreground="{DynamicResource RailTextBrush}" />
          <Button Content="Labels" Command="{Binding PrintLabelsCommand}"
                  IsVisible="{Binding CanPrintLabels}"
                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                  Padding="16,10" Background="Transparent" BorderThickness="0"
                  Foreground="{DynamicResource RailTextBrush}" />
        </StackPanel>

        <!--
          Reports (task P3-T05, SRS FR-9.1, FR-9.4, RPT-01, RPT-02, RPT-03, RPT-14): four screens that
          swap the content pane in place, like System's ToggleButtons (and, like them, deliberately not
          a second ListBox - NavRailKeyboardNavigationTests looks up exactly one). The sales summary
          and sales by item are cashier-safe; Profit and Returns are owner-only and hidden from a
          cashier as a courtesy - their Application-layer queries refuse a cashier session regardless.
        -->
        <StackPanel Spacing="4" IsVisible="{Binding CanViewReports}">
          <TextBlock Text="REPORTS" Margin="16,0" FontSize="11" FontWeight="Bold"
                     Foreground="{DynamicResource RailMutedTextBrush}" />
          <ToggleButton Content="Sales summary" Command="{Binding SelectReportSectionCommand}" CommandParameter="Sales summary"
                        IsChecked="{Binding SelectedReportSection, Mode=OneWay, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter='Sales summary'}"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                        Padding="16,10" Background="Transparent" BorderThickness="0"
                        Foreground="{DynamicResource RailTextBrush}" />
          <ToggleButton Content="Sales by item" Command="{Binding SelectReportSectionCommand}" CommandParameter="Sales by item"
                        IsChecked="{Binding SelectedReportSection, Mode=OneWay, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter='Sales by item'}"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                        Padding="16,10" Background="Transparent" BorderThickness="0"
                        Foreground="{DynamicResource RailTextBrush}" />
          <ToggleButton Content="Profit" Command="{Binding SelectReportSectionCommand}" CommandParameter="Profit" IsVisible="{Binding CanViewOwnerReports}"
                        IsChecked="{Binding SelectedReportSection, Mode=OneWay, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter='Profit'}"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                        Padding="16,10" Background="Transparent" BorderThickness="0"
                        Foreground="{DynamicResource RailTextBrush}" />
          <ToggleButton Content="Returns" Command="{Binding SelectReportSectionCommand}" CommandParameter="Returns" IsVisible="{Binding CanViewOwnerReports}"
                        IsChecked="{Binding SelectedReportSection, Mode=OneWay, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter='Returns'}"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                        Padding="16,10" Background="Transparent" BorderThickness="0"
                        Foreground="{DynamicResource RailTextBrush}" />
        </StackPanel>

        <!--
          Stock reports (task P3-T06, SRS RPT-08 to RPT-16): stock on hand and the reorder list are open to
          any signed-in user (SRS section 9 lists both for both roles, and neither carries a cost field); the
          rest are owner-only, hidden from a cashier as a courtesy - each query refuses a cashier session
          in the Application layer regardless. Same swap-the-content-pane ToggleButtons as Reports above.
        -->
        <StackPanel Spacing="4" IsVisible="{Binding CanViewReports}">
          <TextBlock Text="STOCK REPORTS" Margin="16,0" FontSize="11" FontWeight="Bold"
                     Foreground="{DynamicResource RailMutedTextBrush}" />
          <ToggleButton Content="Stock on hand" Command="{Binding SelectReportSectionCommand}" CommandParameter="Stock on hand"
                        IsChecked="{Binding SelectedReportSection, Mode=OneWay, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter='Stock on hand'}"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                        Padding="16,10" Background="Transparent" BorderThickness="0"
                        Foreground="{DynamicResource RailTextBrush}" />
          <ToggleButton Content="Reorder list" Command="{Binding SelectReportSectionCommand}" CommandParameter="Reorder list"
                        IsChecked="{Binding SelectedReportSection, Mode=OneWay, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter='Reorder list'}"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                        Padding="16,10" Background="Transparent" BorderThickness="0"
                        Foreground="{DynamicResource RailTextBrush}" />
          <ToggleButton Content="Stock valuation" Command="{Binding SelectReportSectionCommand}" CommandParameter="Stock valuation" IsVisible="{Binding CanViewOwnerReports}"
                        IsChecked="{Binding SelectedReportSection, Mode=OneWay, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter='Stock valuation'}"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                        Padding="16,10" Background="Transparent" BorderThickness="0"
                        Foreground="{DynamicResource RailTextBrush}" />
          <ToggleButton Content="Stock card" Command="{Binding SelectReportSectionCommand}" CommandParameter="Stock card" IsVisible="{Binding CanViewOwnerReports}"
                        IsChecked="{Binding SelectedReportSection, Mode=OneWay, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter='Stock card'}"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                        Padding="16,10" Background="Transparent" BorderThickness="0"
                        Foreground="{DynamicResource RailTextBrush}" />
          <ToggleButton Content="Slow-moving stock" Command="{Binding SelectReportSectionCommand}" CommandParameter="Slow-moving stock" IsVisible="{Binding CanViewOwnerReports}"
                        IsChecked="{Binding SelectedReportSection, Mode=OneWay, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter='Slow-moving stock'}"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                        Padding="16,10" Background="Transparent" BorderThickness="0"
                        Foreground="{DynamicResource RailTextBrush}" />
          <ToggleButton Content="Fast-moving items" Command="{Binding SelectReportSectionCommand}" CommandParameter="Fast-moving items" IsVisible="{Binding CanViewOwnerReports}"
                        IsChecked="{Binding SelectedReportSection, Mode=OneWay, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter='Fast-moving items'}"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                        Padding="16,10" Background="Transparent" BorderThickness="0"
                        Foreground="{DynamicResource RailTextBrush}" />
          <ToggleButton Content="Damage and adjustments" Command="{Binding SelectReportSectionCommand}" CommandParameter="Damage and adjustments" IsVisible="{Binding CanViewOwnerReports}"
                        IsChecked="{Binding SelectedReportSection, Mode=OneWay, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter='Damage and adjustments'}"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                        Padding="16,10" Background="Transparent" BorderThickness="0"
                        Foreground="{DynamicResource RailTextBrush}" />
          <ToggleButton Content="Supplier purchases" Command="{Binding SelectReportSectionCommand}" CommandParameter="Supplier purchases" IsVisible="{Binding CanViewOwnerReports}"
                        IsChecked="{Binding SelectedReportSection, Mode=OneWay, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter='Supplier purchases'}"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                        Padding="16,10" Background="Transparent" BorderThickness="0"
                        Foreground="{DynamicResource RailTextBrush}" />
        </StackPanel>

        <!-- Tax and cash reports (task P3-T06, SRS RPT-19, RPT-21 and the tender reconciliation): owner-only. -->
        <StackPanel Spacing="4" IsVisible="{Binding CanViewOwnerReports}">
          <TextBlock Text="TAX AND CASH REPORTS" Margin="16,0" FontSize="11" FontWeight="Bold"
                     Foreground="{DynamicResource RailMutedTextBrush}" />
          <ToggleButton Content="Tax" Command="{Binding SelectReportSectionCommand}" CommandParameter="Tax"
                        IsChecked="{Binding SelectedReportSection, Mode=OneWay, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter='Tax'}"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                        Padding="16,10" Background="Transparent" BorderThickness="0"
                        Foreground="{DynamicResource RailTextBrush}" />
          <ToggleButton Content="Tender reconciliation" Command="{Binding SelectReportSectionCommand}" CommandParameter="Tender reconciliation"
                        IsChecked="{Binding SelectedReportSection, Mode=OneWay, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter='Tender reconciliation'}"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                        Padding="16,10" Background="Transparent" BorderThickness="0"
                        Foreground="{DynamicResource RailTextBrush}" />
          <ToggleButton Content="Shift variance" Command="{Binding SelectReportSectionCommand}" CommandParameter="Shift variance"
                        IsChecked="{Binding SelectedReportSection, Mode=OneWay, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter='Shift variance'}"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                        Padding="16,10" Background="Transparent" BorderThickness="0"
                        Foreground="{DynamicResource RailTextBrush}" />
        </StackPanel>

        <!-- People: unchanged from task P3-T13, still opening UserAdminWindow outright -->
        <StackPanel Spacing="4" IsVisible="{Binding CanManageUsers}">
          <TextBlock Text="PEOPLE" Margin="16,0" FontSize="11" FontWeight="Bold"
                     Foreground="{DynamicResource RailMutedTextBrush}" />
          <Button Content="Users" Command="{Binding ManageUsersCommand}"
                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                  Padding="16,10" Background="Transparent" BorderThickness="0"
                  Foreground="{DynamicResource RailTextBrush}" />
        </StackPanel>

        <!--
          System: the nine settings groups SettingsWindow's old TabControl hosted, folded straight
          into the content pane by task P3-T19 (SRS FR-10.1-10.9, UI-13) - SettingsWindow itself is
          retired. Each button sets BackOfficeShellViewModel.SelectedSettingsSection through
          SelectSettingsSectionCommand/CommandParameter; the navigate-AWAY-from-System guard lives
          entirely on the viewmodel (see its own remarks), not here - nothing below needs to know
          about it.
        -->
        <StackPanel Spacing="4" IsVisible="{Binding CanChangeSettings}">
          <TextBlock Text="SYSTEM" Margin="16,0" FontSize="11" FontWeight="Bold"
                     Foreground="{DynamicResource RailMutedTextBrush}" />
          <ToggleButton Content="Shop profile" Command="{Binding SelectSettingsSectionCommand}" CommandParameter="Shop profile"
                        IsChecked="{Binding SelectedSettingsSection, Mode=OneWay, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter='Shop profile'}"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                        Padding="16,10" Background="Transparent" BorderThickness="0"
                        Foreground="{DynamicResource RailTextBrush}" />
          <ToggleButton Content="Financial" Command="{Binding SelectSettingsSectionCommand}" CommandParameter="Financial"
                        IsChecked="{Binding SelectedSettingsSection, Mode=OneWay, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter=Financial}"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                        Padding="16,10" Background="Transparent" BorderThickness="0"
                        Foreground="{DynamicResource RailTextBrush}" />
          <ToggleButton Content="Tax" Command="{Binding SelectSettingsSectionCommand}" CommandParameter="Tax"
                        IsChecked="{Binding SelectedSettingsSection, Mode=OneWay, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter=Tax}"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                        Padding="16,10" Background="Transparent" BorderThickness="0"
                        Foreground="{DynamicResource RailTextBrush}" />
          <ToggleButton Content="Numbering" Command="{Binding SelectSettingsSectionCommand}" CommandParameter="Numbering"
                        IsChecked="{Binding SelectedSettingsSection, Mode=OneWay, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter=Numbering}"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                        Padding="16,10" Background="Transparent" BorderThickness="0"
                        Foreground="{DynamicResource RailTextBrush}" />
          <ToggleButton Content="Policy" Command="{Binding SelectSettingsSectionCommand}" CommandParameter="Policy"
                        IsChecked="{Binding SelectedSettingsSection, Mode=OneWay, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter=Policy}"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                        Padding="16,10" Background="Transparent" BorderThickness="0"
                        Foreground="{DynamicResource RailTextBrush}" />
          <ToggleButton Content="Peripherals" Command="{Binding SelectSettingsSectionCommand}" CommandParameter="Peripherals"
                        IsChecked="{Binding SelectedSettingsSection, Mode=OneWay, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter=Peripherals}"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                        Padding="16,10" Background="Transparent" BorderThickness="0"
                        Foreground="{DynamicResource RailTextBrush}" />
          <ToggleButton Content="Backup" Command="{Binding SelectSettingsSectionCommand}" CommandParameter="Backup"
                        IsChecked="{Binding SelectedSettingsSection, Mode=OneWay, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter=Backup}"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                        Padding="16,10" Background="Transparent" BorderThickness="0"
                        Foreground="{DynamicResource RailTextBrush}" />
          <ToggleButton Content="Receipt" Command="{Binding SelectSettingsSectionCommand}" CommandParameter="Receipt"
                        IsChecked="{Binding SelectedSettingsSection, Mode=OneWay, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter=Receipt}"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                        Padding="16,10" Background="Transparent" BorderThickness="0"
                        Foreground="{DynamicResource RailTextBrush}" />
          <ToggleButton Content="Display" Command="{Binding SelectSettingsSectionCommand}" CommandParameter="Display"
                        IsChecked="{Binding SelectedSettingsSection, Mode=OneWay, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter=Display}"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                        Padding="16,10" Background="Transparent" BorderThickness="0"
                        Foreground="{DynamicResource RailTextBrush}" />
        </StackPanel>

      </StackPanel>
    </ScrollViewer>
  </Border>

</UserControl>
