<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Counterpoint.Ui.ViewModels.Reports"
             xmlns:views="using:Counterpoint.Ui.Views.Reports"
             xmlns:controls="using:Counterpoint.Ui.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="960" d:DesignHeight="640"
             x:Class="Counterpoint.Ui.Views.Reports.FastMovingView"
             x:DataType="vm:FastMovingViewModel">

  <!--
    Task P3-T06, fast-moving items (SRS RPT-13, owner-only). Markup and nothing else: every figure is bound to
    the matching report viewmodel, itself a pass-through of one Application-layer query, and every
    table is a shared ReportTableView. A refusal or a failed read shows as the status sentence.
    Tokens only, no hex. Every field is a persistent-label P3-T12 LabeledField (AC-22).
  -->
  <UserControl.Styles>
    <StyleInclude Source="avares://Counterpoint.Ui/Views/Reports/ReportStyles.axaml" />
  </UserControl.Styles>

  <DockPanel>

    <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,12">
      <TextBlock Text="Fast-moving items" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" />
      <TextBlock Classes="Note" TextWrapping="Wrap" Text="Top sellers by units and by value, net of returns and excluding tax - the same figures as sales by item." />
      <StackPanel Orientation="Horizontal" Spacing="12">
        <views:ReportRangeBar DataContext="{Binding Range}" />
        <controls:LabeledTextField Width="110" Label="Top how many" Text="{Binding TopNText}" ValidationMessage="{Binding TopNValidation}" />
        <Button Content="_Run" Command="{Binding RunCommand}" IsEnabled="{Binding !Busy}" Margin="0,26,0,0" />
      </StackPanel>
      <TextBlock Text="{Binding Status}" Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap" IsVisible="{Binding HasStatus}" />
    </StackPanel>

    <ScrollViewer>
      <StackPanel Spacing="8">

        <views:ReportTableView DataContext="{Binding ByUnits}" />
        <views:ReportTableView DataContext="{Binding ByValue}" />

      </StackPanel>
    </ScrollViewer>

  </DockPanel>

</UserControl>
