<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Counterpoint.Ui.ViewModels.Reports"
             xmlns:views="using:Counterpoint.Ui.Views.Reports"
             xmlns:controls="using:Counterpoint.Ui.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="960" d:DesignHeight="640"
             x:Class="Counterpoint.Ui.Views.Reports.ShiftVarianceView"
             x:DataType="vm:ShiftVarianceViewModel">

  <!--
    Task P3-T06, shift and cash variance history (SRS RPT-21, owner-only). Markup and nothing else: every figure is bound to
    the matching report viewmodel, itself a pass-through of one Application-layer query, and every
    table is a shared ReportTableView. A refusal or a failed read shows as the status sentence.
    Tokens only, no hex. Every field is a persistent-label P3-T12 LabeledField (AC-22).
  -->
  <UserControl.Styles>
    <StyleInclude Source="avares://Counterpoint.Ui/Views/Reports/ReportStyles.axaml" />
  </UserControl.Styles>

  <DockPanel>

    <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,12">
      <TextBlock Text="Shift and cash variance history" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" />
      <TextBlock Classes="Note" TextWrapping="Wrap" Text="Counted against expected cash for every closed shift in the range. A negative variance is short, a positive one is over." />
      <StackPanel Orientation="Horizontal" Spacing="12">
        <views:ReportRangeBar DataContext="{Binding Range}" />
        <Button Content="_Run" Command="{Binding RunCommand}" IsEnabled="{Binding !Busy}" Margin="0,26,0,0" />
      </StackPanel>
      <TextBlock Text="{Binding Status}" Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap" IsVisible="{Binding HasStatus}" />
    </StackPanel>

    <ScrollViewer>
      <StackPanel Spacing="8">

        <UniformGrid Columns="5" Rows="1">
          <Border Classes="KpiCard"><StackPanel><TextBlock Classes="KpiLabel" Text="Shifts" /><TextBlock Classes="KpiValue" Text="{Binding ShiftCountText}" /></StackPanel></Border>
          <Border Classes="KpiCard"><StackPanel><TextBlock Classes="KpiLabel" Text="Net variance" /><TextBlock Classes="KpiValue" Text="{Binding NetVarianceText}" /></StackPanel></Border>
          <Border Classes="KpiCard"><StackPanel><TextBlock Classes="KpiLabel" Text="Total over" /><TextBlock Classes="KpiValue" Text="{Binding TotalOverText}" /></StackPanel></Border>
          <Border Classes="KpiCard"><StackPanel><TextBlock Classes="KpiLabel" Text="Total short" /><TextBlock Classes="KpiValue" Text="{Binding TotalShortText}" /></StackPanel></Border>
          <Border Classes="KpiCard"><StackPanel><TextBlock Classes="KpiLabel" Text="Average swing" /><TextBlock Classes="KpiValue" Text="{Binding MeanAbsoluteText}" /></StackPanel></Border>
        </UniformGrid>
      <TextBlock Classes="Note" Text="{Binding ThresholdText}" TextWrapping="Wrap" />
      <TextBlock Classes="Cell" Text="{Binding TrendText}" TextWrapping="Wrap" />
        <views:ReportTableView DataContext="{Binding Shifts}" />

      </StackPanel>
    </ScrollViewer>

  </DockPanel>

</UserControl>
