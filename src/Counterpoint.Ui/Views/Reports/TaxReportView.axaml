<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Counterpoint.Ui.ViewModels.Reports"
             xmlns:views="using:Counterpoint.Ui.Views.Reports"
             xmlns:controls="using:Counterpoint.Ui.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="960" d:DesignHeight="640"
             x:Class="Counterpoint.Ui.Views.Reports.TaxReportView"
             x:DataType="vm:TaxReportViewModel">

  <!--
    Task P3-T06, tax report (SRS RPT-19, owner-only). Markup and nothing else: every figure is bound to
    the matching report viewmodel, itself a pass-through of one Application-layer query, and every
    table is a shared ReportTableView. A refusal or a failed read shows as the status sentence.
    Tokens only, no hex. Every field is a persistent-label P3-T12 LabeledField (AC-22).
  -->
  <UserControl.Styles>
    <StyleInclude Source="avares://Counterpoint.Ui/Views/Reports/ReportStyles.axaml" />
  </UserControl.Styles>

  <DockPanel>

    <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,12">
      <TextBlock Text="Tax report" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" />
      <TextBlock Classes="Note" TextWrapping="Wrap" Text="Taxable value and tax collected by rate, with tax on returns netted off. Taxable values exclude tax. Rates are the ones actually charged on each bill line; returns with no link to a bill line are shown separately and never guessed into a rate." />
      <StackPanel Orientation="Horizontal" Spacing="12">
        <views:ReportRangeBar DataContext="{Binding Range}" />
        <Button Content="_Run" Command="{Binding RunCommand}" IsEnabled="{Binding !Busy}" Margin="0,26,0,0" />
      </StackPanel>
      <TextBlock Classes="Cell Bold" Text="{Binding ShopText}" TextWrapping="Wrap" />
      <TextBlock Classes="Cell" Text="{Binding RegistrationText}" TextWrapping="Wrap" />
      <TextBlock Classes="Note" Text="{Binding BasisText}" TextWrapping="Wrap" />
      <TextBlock Text="{Binding Status}" Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap" IsVisible="{Binding HasStatus}" />
    </StackPanel>

    <ScrollViewer>
      <StackPanel Spacing="8">

        <UniformGrid Columns="4" Rows="1">
          <Border Classes="KpiCard"><StackPanel><TextBlock Classes="KpiLabel" Text="Sales (taxable value)" /><TextBlock Classes="KpiValue" Text="{Binding TotalSalesTaxableText}" /></StackPanel></Border>
          <Border Classes="KpiCard"><StackPanel><TextBlock Classes="KpiLabel" Text="Tax on sales" /><TextBlock Classes="KpiValue" Text="{Binding TotalSalesTaxText}" /></StackPanel></Border>
          <Border Classes="KpiCard"><StackPanel><TextBlock Classes="KpiLabel" Text="Tax on returns" /><TextBlock Classes="KpiValue" Text="{Binding TotalReturnsTaxText}" /></StackPanel></Border>
          <Border Classes="KpiCard"><StackPanel><TextBlock Classes="KpiLabel" Text="Net tax due" /><TextBlock Classes="KpiValue" Text="{Binding NetTaxText}" /></StackPanel></Border>
        </UniformGrid>
      <TextBlock Classes="Cell" Classes.Warn="{Binding ReconciliationWarning}" Text="{Binding ReconciliationText}" TextWrapping="Wrap" />
        <views:ReportTableView DataContext="{Binding Rates}" />

      </StackPanel>
    </ScrollViewer>

  </DockPanel>

</UserControl>
