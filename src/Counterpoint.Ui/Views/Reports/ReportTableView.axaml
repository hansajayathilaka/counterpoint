<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Counterpoint.Ui.ViewModels.Reports"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="240"
             x:Class="Counterpoint.Ui.Views.Reports.ReportTableView"
             x:DataType="vm:ReportTableViewModel">

  <!--
    Task P3-T06. One display-only table: a title, fixed-width columns (the heading row and each data row
    are the same cell widths, so they line up), an empty-state sentence and a "more rows not shown" note.
    Every cell is text the Application layer's DTO already carries, formatted by ReportText. A warning
    cell takes the WarningBrush token. No hex literals.
  -->
  <UserControl.Styles>
    <StyleInclude Source="avares://Counterpoint.Ui/Views/Reports/ReportStyles.axaml" />
  </UserControl.Styles>

  <StackPanel Spacing="2" Margin="0,4,0,8">
    <TextBlock Classes="SectionTitle" Text="{Binding Title}" IsVisible="{Binding HasTitle}" />
    <TextBlock Classes="Note" Text="{Binding EmptyText}" IsVisible="{Binding IsEmpty}" />

    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" IsVisible="{Binding HasRows}">
      <StackPanel>

        <ItemsControl ItemsSource="{Binding Headers}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:ReportCell">
              <TextBlock Classes="Head" Classes.Num="{Binding IsNumeric}"
                         Width="{Binding Width}" Text="{Binding Text}"
                         TextWrapping="Wrap" Margin="0,0,8,4" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <ItemsControl ItemsSource="{Binding Rows}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:ReportTableRow">
              <ItemsControl ItemsSource="{Binding Cells}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:ReportCell">
                    <TextBlock Classes="Cell" Classes.Num="{Binding IsNumeric}"
                               Classes.Bold="{Binding IsBold}" Classes.Warn="{Binding IsWarning}"
                               Width="{Binding Width}" Text="{Binding Text}"
                               TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Text}"
                               Margin="0,2,8,2" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

      </StackPanel>
    </ScrollViewer>

    <TextBlock Classes="Warn" Text="{Binding HiddenRowsText}" IsVisible="{Binding HasHiddenRows}" />
  </StackPanel>

</UserControl>
