<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Counterpoint.Ui.ViewModels.Purchasing"
        xmlns:catalogueVm="using:Counterpoint.Ui.ViewModels.Catalogue"
        xmlns:controls="using:Counterpoint.Ui.Controls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="700"
        x:Class="Counterpoint.Ui.Views.Purchasing.PurchaseOrderWindow"
        x:DataType="vm:PurchaseOrderViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Width="1100" Height="700"
        WindowStartupLocation="CenterOwner"
        Title="Counterpoint - purchase orders">

  <!--
    Owner only - not by anything on this window, but by [RequiresRole(Role.Owner)] on
    IPurchaseOrderService (SRS NFR-S2, AC-17). Two tabs: raising/sending/cancelling/printing
    orders (SRS FR-4.5, FR-4.10), and the suggested-order report (SRS FR-4.6).

    Task P3-T16: a document-building screen shaped like SalesWindow's own side panel (P3-T14),
    not a master-data New/Edit/Delete list, so it is retrofitted onto the P3-T10 tokens and the
    P3-T12 LabeledField family directly rather than the P3-T11 EditDialogWindow shell.
  -->
  <DockPanel Margin="10">
    <TextBlock DockPanel.Dock="Bottom" Margin="0,8,0,0" TextWrapping="Wrap" Text="{Binding Status}" />

    <TabControl>
      <TabItem Header="Purchase orders">
        <Grid ColumnDefinitions="360,*" Margin="8">

          <!-- The order list -->
          <DockPanel Grid.Column="0" Margin="0,0,8,0">
            <Button DockPanel.Dock="Top" Content="_New order" Command="{Binding NewOrderCommand}"
                    IsEnabled="{Binding !Busy}" Margin="0,0,0,6" />
            <ListBox ItemsSource="{Binding Orders}" SelectedItem="{Binding SelectedOrder}">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:PurchaseOrderSummaryRowViewModel">
                  <StackPanel>
                    <TextBlock Text="{Binding PoNo}" FontWeight="Bold" />
                    <TextBlock Text="{Binding SupplierName}" />
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <TextBlock Text="{Binding Status}" />
                      <TextBlock Text="{Binding TotalText}" />
                    </StackPanel>
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </DockPanel>

          <!-- Detail / new-order builder -->
          <DockPanel Grid.Column="1">

            <!-- Selected order's own actions -->
            <Border DockPanel.Dock="Top" IsVisible="{Binding HasSelectedOrder}"
                    Margin="0,0,0,10" Padding="0,0,0,10" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource PanelBorderBrush}">
              <StackPanel Spacing="6">
                <TextBlock Text="{Binding SelectedOrderDetail.PoNo}" FontSize="16" FontWeight="Bold" />
                <StackPanel Orientation="Horizontal" Spacing="16">
                  <TextBlock Text="{Binding SelectedOrderDetail.SupplierName}" />
                  <TextBlock Text="{Binding SelectedOrderDetail.Status}" />
                </StackPanel>
                <ItemsControl ItemsSource="{Binding SelectedOrderLines}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:PurchaseOrderLineRowViewModel">
                      <Grid ColumnDefinitions="90,220,110,90,90,160" Margin="0,2">
                        <TextBlock Grid.Column="0" Text="{Binding Sku}" />
                        <TextBlock Grid.Column="1" Text="{Binding ProductDescription}" />
                        <TextBlock Grid.Column="2" Text="{Binding QtyText}" />
                        <TextBlock Grid.Column="3" Text="{Binding UnitCostText}" />
                        <TextBlock Grid.Column="4" Text="{Binding LineTotalText}" />
                        <TextBlock Grid.Column="5" Text="{Binding ReceivedText}" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
                  <Button Content="_Send" Command="{Binding SendCommand}"
                          IsEnabled="{Binding CanSendSelected}" />
                  <Button Content="_Print" Command="{Binding PrintCommand}" />
                  <controls:LabeledTextField Width="240" Label="Cancellation reason" Text="{Binding CancelReason}" />
                  <Button Content="Ca_ncel order" Command="{Binding CancelCommand}"
                          IsEnabled="{Binding CanCancelSelected}" />
                </StackPanel>
              </StackPanel>
            </Border>

            <!-- New-order builder -->
            <StackPanel Spacing="8">
              <TextBlock Text="New purchase order" FontSize="16" FontWeight="Bold" />

              <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
                <!--
                  A plain TextBlock+ComboBox pair wired to AutomationProperties.LabeledBy in the
                  code-behind, the same accepted fallback ImportTabView/ProductTabView/
                  BackupSettingsView use for a field the LabeledField family cannot express - here
                  because the family's LabeledComboField has no ItemTemplate passthrough, and this
                  combo needs one to show a supplier's name rather than its ToString().
                -->
                <StackPanel Spacing="4">
                  <TextBlock Name="SupplierLabel" Text="Supplier" Foreground="{DynamicResource SecondaryTextBrush}" />
                  <ComboBox Name="SupplierCombo" Width="220" ItemsSource="{Binding Suppliers}" SelectedItem="{Binding DraftSupplier}"
                            PlaceholderText="Supplier">
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="catalogueVm:SupplierRowViewModel">
                        <TextBlock Text="{Binding Name}" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                </StackPanel>
                <controls:LabeledTextField Width="140" Label="Expected date (yyyy-mm-dd)" Text="{Binding DraftExpectedDate}" />
                <controls:LabeledTextField Width="220" Label="Note" Text="{Binding DraftNote}" />
              </StackPanel>

              <StackPanel Orientation="Horizontal" Spacing="8">
                <controls:LabeledTextField Width="260" Label="Find a product to order" Text="{Binding LineSearchQuery}" />
              </StackPanel>

              <ListBox Height="90" ItemsSource="{Binding LineSearchResults}" SelectedItem="{Binding SelectedLineSearchResult}">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:PurchaseOrderSearchResultViewModel">
                    <StackPanel Margin="0,2">
                      <TextBlock Text="{Binding ProductName}" FontWeight="Bold" />
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="{Binding Sku}" />
                        <TextBlock Text="{Binding StockText}" />
                      </StackPanel>
                    </StackPanel>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <Button Content="_Pick product" Command="{Binding PickLineProductCommand}"
                      CommandParameter="{Binding SelectedLineSearchResult}" />

              <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding HasPickedProduct}" VerticalAlignment="Bottom">
                <TextBlock VerticalAlignment="Center" Text="{Binding PickedProduct.ProductName}" />
                <controls:LabeledComboField Width="160" Label="Unit" ItemsSource="{Binding PickedProductUoms}" SelectedItem="{Binding SelectedUom}" />
                <Button Content="_Add line" Command="{Binding AddDraftLineCommand}" />
              </StackPanel>

              <ItemsControl ItemsSource="{Binding DraftLines}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:PurchaseOrderDraftLineViewModel">
                    <Grid ColumnDefinitions="220,90,90,90,80" Margin="0,2" VerticalAlignment="Bottom">
                      <TextBlock Grid.Column="0" Text="{Binding ProductDescription}" VerticalAlignment="Center" />
                      <controls:LabeledNumericField Grid.Column="1" Label="Qty" Text="{Binding Quantity}" />
                      <TextBlock Grid.Column="2" Text="{Binding UomSymbol}" VerticalAlignment="Center" />
                      <controls:LabeledNumericField Grid.Column="3" Label="Cost" Text="{Binding UnitCost}" />
                      <Button Grid.Column="4" Content="Remove" VerticalAlignment="Center"
                              Command="{Binding $parent[Window].((vm:PurchaseOrderViewModel)DataContext).RemoveDraftLineCommand}"
                              CommandParameter="{Binding}" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <Button Content="_Save purchase order" Command="{Binding SaveDraftCommand}" IsEnabled="{Binding !Busy}" />
            </StackPanel>
          </DockPanel>
        </Grid>
      </TabItem>

      <TabItem Header="Suggested order">
        <DockPanel Margin="8">
          <Button DockPanel.Dock="Top" Content="_Refresh" Command="{Binding RefreshSuggestedOrderCommand}"
                  IsEnabled="{Binding !Busy}" Margin="0,0,0,8" />
          <ListBox ItemsSource="{Binding SuggestedOrders}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:SuggestedOrderRowViewModel">
                <Grid ColumnDefinitions="90,260,160,160,160">
                  <TextBlock Grid.Column="0" Text="{Binding ProductCode}" />
                  <TextBlock Grid.Column="1" Text="{Binding ProductDescription}" />
                  <TextBlock Grid.Column="2" Text="{Binding OnHandText}" />
                  <TextBlock Grid.Column="3" Text="{Binding ReorderLevelText}" />
                  <TextBlock Grid.Column="4" Text="{Binding SuggestedQtyText}" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </TabItem>
    </TabControl>
  </DockPanel>

</Window>
