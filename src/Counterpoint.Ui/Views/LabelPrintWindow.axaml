<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Counterpoint.Ui.ViewModels.Labels"
        xmlns:controls="using:Counterpoint.Ui.Controls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="600"
        x:Class="Counterpoint.Ui.Views.LabelPrintWindow"
        x:DataType="vm:LabelPrintViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Width="900" Height="600"
        WindowStartupLocation="CenterOwner"
        Title="Counterpoint - print labels">

  <!--
    Print for a hand-picked product list or a search result set (SRS FR-2.10, FR-2.12). No
    styling beyond what is needed to read it - the same minimal-first approach SalesWindow takes,
    because the layout worth polishing is the one on the label itself, not this screen. Task
    P3-T16: the two free-text/numeric fields are P3-T12 LabeledField controls (SRS UI-06, UI-14,
    AC-22).
  -->
  <DockPanel Margin="12">

    <TextBlock DockPanel.Dock="Bottom" Margin="0,8,0,0" TextWrapping="Wrap" Text="{Binding Status}" />

    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,12,*" RowDefinitions="Auto,*,Auto">

      <!-- Search: types or scans a barcode, finds a result set to add from. -->
      <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
        <controls:LabeledTextField Width="260" Label="Search or scan a barcode" Text="{Binding SearchText}">
          <controls:LabeledTextField.KeyBindings>
            <KeyBinding Gesture="Enter" Command="{Binding SearchCommand}" />
          </controls:LabeledTextField.KeyBindings>
        </controls:LabeledTextField>
        <Button Content="_Search" Command="{Binding SearchCommand}" />
        <Button Content="_Add to batch" Command="{Binding AddSelectedToBatchCommand}" />
      </StackPanel>

      <ListBox Grid.Row="1" Grid.Column="0" Margin="0,8,0,0"
                ItemsSource="{Binding SearchResults}"
                SelectedItem="{Binding SelectedSearchResult}">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:LabelSearchResultViewModel">
            <Grid ColumnDefinitions="*,Auto,Auto,Auto">
              <TextBlock Grid.Column="0" Text="{Binding ProductName}" />
              <TextBlock Grid.Column="1" Margin="12,0,0,0" Text="{Binding Sku}" />
              <TextBlock Grid.Column="2" Margin="12,0,0,0" Text="{Binding UomSymbol}" />
              <TextBlock Grid.Column="3" Margin="12,0,0,0" Text="{Binding UnitPriceText}" />
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <!-- The batch: what will actually be printed, and how many labels each product gets. -->
      <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal" Spacing="8">
        <TextBlock VerticalAlignment="Center" Text="Batch" FontWeight="Bold" />
        <Button Content="_Remove" Command="{Binding RemoveSelectedFromBatchCommand}" />
      </StackPanel>

      <ListBox Grid.Row="1" Grid.Column="2" Margin="0,8,0,0"
                ItemsSource="{Binding Batch}"
                SelectedItem="{Binding SelectedBatchLine}">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:LabelBatchLineViewModel">
            <Grid ColumnDefinitions="*,Auto,Auto,Auto" VerticalAlignment="Bottom">
              <TextBlock Grid.Column="0" Text="{Binding ProductName}" VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" Margin="12,0,0,0" Text="{Binding Sku}" VerticalAlignment="Center" />
              <TextBlock Grid.Column="2" Margin="12,0,0,0" Text="{Binding UnitPriceText}" VerticalAlignment="Center" />
              <controls:LabeledNumericField Grid.Column="3" Width="70" Margin="8,0,0,0" Label="Qty" Text="{Binding QuantityText}" />
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal"
                  Margin="0,8,0,0" Spacing="8">
        <Button Content="_Preview" Command="{Binding PreviewCommand}" />
        <Button Content="_Print" Command="{Binding PrintCommand}" IsEnabled="{Binding !Busy}" />
      </StackPanel>

    </Grid>

    <Border BorderThickness="1" Padding="8" Margin="0,8,0,0">
      <ScrollViewer>
        <TextBlock TextWrapping="Wrap" FontFamily="monospace" Text="{Binding PreviewText}" />
      </ScrollViewer>
    </Border>

  </DockPanel>

</Window>
