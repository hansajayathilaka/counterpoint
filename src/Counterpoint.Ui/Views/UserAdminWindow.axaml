<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Counterpoint.Ui.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="720" d:DesignHeight="520"
        x:Class="Counterpoint.Ui.Views.UserAdminWindow"
        x:DataType="vm:UserAdminViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Width="720" Height="520"
        WindowStartupLocation="CenterOwner"
        Title="Counterpoint - users">

  <!--
    Owner-only, and the Application layer is what makes that true. Task P3-T16 (SRS UI-05, UI-06,
    UI-15, AC-22, AC-23): the old always-visible "Add a user" inline form and the inline
    reset-password box are gone, replaced by New and Reset password commands that open the shared
    EditDialogWindow shell through IDialogService, hosting UserEditViewModel - the same pattern
    task P3-T11/P3-T15 already converted every catalogue tab onto. Turning an account on or off
    stays an inline action, the same choice task P3-T15 made for CategoryTabViewModel's own
    toggle-active button: there is no ambiguous New/Edit/Delete shape to it.
  -->
  <DockPanel Margin="12">

    <TextBlock DockPanel.Dock="Bottom" Margin="0,8,0,0" TextWrapping="Wrap" Text="{Binding Status}" />

    <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0" Spacing="6">

      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Content="_New user" Command="{Binding NewUserDialogCommand}" IsEnabled="{Binding !Busy}" />
        <Button Content="_Reset password" Command="{Binding ResetPasswordDialogCommand}" IsEnabled="{Binding !Busy}" />
        <Button Content="Turn on / off" Command="{Binding ToggleActiveCommand}" IsEnabled="{Binding !Busy}" />
      </StackPanel>

    </StackPanel>

    <ListBox ItemsSource="{Binding Users}" SelectedItem="{Binding SelectedUser}">
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="vm:UserRowViewModel">
          <Grid ColumnDefinitions="140,*,90,70,Auto,Auto">
            <TextBlock Grid.Column="0" Text="{Binding Username}" />
            <TextBlock Grid.Column="1" Text="{Binding DisplayName}" />
            <TextBlock Grid.Column="2" Text="{Binding RoleText}" />
            <TextBlock Grid.Column="3" Text="{Binding StateText}" />
            <TextBlock Grid.Column="4" Margin="12,0,0,0" Text="{Binding LastLoginText}" />
            <TextBlock Grid.Column="5" Margin="12,0,0,0" Text="{Binding LockedText}" />
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

  </DockPanel>

</Window>
