<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Counterpoint.Ui.ViewModels.Catalogue"
             xmlns:controls="using:Counterpoint.Ui.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="380" d:DesignHeight="140"
             x:Class="Counterpoint.Ui.Views.Catalogue.CategoryEditView"
             x:DataType="vm:CategoryEditViewModel">

  <!--
    Task P3-T11's proof-of-concept content, now built from task P3-T12's LabeledField control
    family: a persistent label identifies each field in every state - empty, focused, filled and
    disabled (SRS UI-06, UI-14, AC-22) - never a watermark standing in as the only label.
  -->
  <StackPanel Spacing="12">
    <controls:LabeledTextField Name="NameField" Label="Category name" Text="{Binding Name}" />
    <controls:LabeledComboField Name="ParentField"
                                 Label="Parent category"
                                 ItemsSource="{Binding ParentOptions}"
                                 SelectedItem="{Binding SelectedParent}" />
  </StackPanel>

</UserControl>
