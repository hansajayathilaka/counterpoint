<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Counterpoint.Ui.ViewModels.Catalogue"
             xmlns:import="using:Counterpoint.Application.Import"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="860" d:DesignHeight="640"
             x:Class="Counterpoint.Ui.Views.Catalogue.ImportTabView"
             x:DataType="vm:ImportTabViewModel">

  <!--
    Spreadsheet catalogue import and export (SRS FR-2.22, FR-2.23, AC-07, Q-08,
    docs/03_PHASE_1_core_trading.md P1-T13). Owner only, exactly as the six reference-data tabs
    and the product tab beside this one are - by ICatalogueImportService's
    [RequiresRole(Role.Owner)], not by anything on this screen (SRS NFR-S2, AC-17).

    Commit is disabled (HasCleanPreview) until a dry run over exactly this file and this mapping
    has come back with zero error rows - the viewmodel re-checks that at commit time too, this is
    just the same rule shown early.
  -->
  <DockPanel Margin="12">

    <TextBlock DockPanel.Dock="Bottom" Margin="0,8,0,0" TextWrapping="Wrap" Text="{Binding Status}" />

    <StackPanel DockPanel.Dock="Top" Spacing="6">
      <TextBlock FontWeight="Bold" Text="1. Choose a file" />
      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBox Width="440" IsReadOnly="True" Watermark="No file chosen" Text="{Binding FilePath}" />
        <Button Content="_Browse..." Click="OnBrowseFileClick" IsEnabled="{Binding !Busy}" />
        <Button Content="_Load headers" Command="{Binding LoadHeadersCommand}" IsEnabled="{Binding !Busy}" />
        <Button Content="E_xport catalogue..." Click="OnExportClick" IsEnabled="{Binding !Busy}" />
      </StackPanel>

      <TextBlock Margin="0,8,0,0" FontWeight="Bold" Text="2. Map columns, or apply a saved profile" />
      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBlock VerticalAlignment="Center" Text="Saved profile" />
        <ComboBox Width="220" ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="import:ImportMappingProfile">
              <TextBlock Text="{Binding Name}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <Button Content="A_pply" Command="{Binding ApplyProfileCommand}" IsEnabled="{Binding !Busy}" />
        <Button Content="D_elete" Command="{Binding DeleteProfileCommand}" IsEnabled="{Binding !Busy}" />
        <TextBox Width="200" Watermark="Save mapping as..." Text="{Binding ProfileNameToSave}" />
        <Button Content="_Save mapping" Command="{Binding SaveProfileCommand}" IsEnabled="{Binding !Busy}" />
      </StackPanel>
    </StackPanel>

    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
      <Button Content="3. _Dry run preview" Command="{Binding PreviewCommand}" IsEnabled="{Binding !Busy}" />
      <Button Content="4. _Commit" Command="{Binding CommitCommand}" IsEnabled="{Binding HasCleanPreview}" />
      <TextBlock VerticalAlignment="Center" Text="{Binding CountsText}" />
    </StackPanel>

    <Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,*,*,*" Margin="0,8,0,0" MinHeight="150" MaxHeight="220">
      <StackPanel Grid.Column="0" Margin="0,0,4,0">
        <TextBlock FontWeight="Bold" Text="Create sample" />
        <ListBox ItemsSource="{Binding CreateSample}">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:ImportRowResultViewModel">
              <TextBlock TextWrapping="Wrap" Text="{Binding Code}" />
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </StackPanel>

      <StackPanel Grid.Column="1" Margin="4,0">
        <TextBlock FontWeight="Bold" Text="Update sample" />
        <ListBox ItemsSource="{Binding UpdateSample}">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:ImportRowResultViewModel">
              <TextBlock TextWrapping="Wrap" Text="{Binding Code}" />
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </StackPanel>

      <StackPanel Grid.Column="2" Margin="4,0">
        <TextBlock FontWeight="Bold" Text="Skip sample" />
        <ListBox ItemsSource="{Binding SkipSample}">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:ImportRowResultViewModel">
              <TextBlock TextWrapping="Wrap" Text="{Binding Code}" />
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </StackPanel>

      <StackPanel Grid.Column="3" Margin="4,0,0,0">
        <TextBlock FontWeight="Bold" Text="Error sample" />
        <ListBox ItemsSource="{Binding ErrorSample}">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:ImportRowResultViewModel">
              <StackPanel>
                <TextBlock Text="{Binding Code}" FontWeight="SemiBold" />
                <TextBlock TextWrapping="Wrap" FontSize="11" Text="{Binding ErrorsText}" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </StackPanel>
    </Grid>

    <ScrollViewer>
      <ItemsControl ItemsSource="{Binding MappingRows}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:ImportFieldMappingRowViewModel">
            <Grid ColumnDefinitions="140,280" Margin="0,2">
              <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="{Binding Label}" />
              <ComboBox Grid.Column="1" HorizontalAlignment="Left"
                        ItemsSource="{Binding HeaderChoices}"
                        SelectedItem="{Binding SelectedHeader}" />
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

  </DockPanel>

</UserControl>
