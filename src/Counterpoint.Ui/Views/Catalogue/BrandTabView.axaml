<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Counterpoint.Ui.ViewModels.Catalogue"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="860" d:DesignHeight="560"
             x:Class="Counterpoint.Ui.Views.Catalogue.BrandTabView"
             x:DataType="vm:BrandTabViewModel">

  <!--
    Task P3-T15 (SRS UI-05, UI-06, UI-14, UI-15, AC-22, AC-23): New and Edit each open the shared
    EditDialogWindow through IDialogService rather than the old inline form that was bound to
    whichever row happened to be selected, shared by a "_New" button and a "_Save" button with
    nothing on screen naming the action or the record. Delete confirms through the same shell,
    naming the selected brand, before anything happens (SRS UI-05).
  -->
  <DockPanel Margin="12">

    <TextBlock DockPanel.Dock="Bottom" Margin="0,8,0,0" TextWrapping="Wrap" Text="{Binding Status}" />

    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
      <Button Content="_New" Command="{Binding NewCommand}" IsEnabled="{Binding !Busy}" />
      <Button Content="_Edit" Command="{Binding EditCommand}" IsEnabled="{Binding !Busy}" />
      <Button Content="Turn on / off" Command="{Binding ToggleActiveCommand}" IsEnabled="{Binding !Busy}" />
      <Button Content="_Delete" Command="{Binding DeleteCommand}" IsEnabled="{Binding !Busy}" />
    </StackPanel>

    <ListBox ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}">
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="vm:BrandRowViewModel">
          <Grid ColumnDefinitions="240,90">
            <TextBlock Grid.Column="0" Text="{Binding Name}" />
            <TextBlock Grid.Column="1" Text="{Binding StateText}" />
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

  </DockPanel>

</UserControl>
