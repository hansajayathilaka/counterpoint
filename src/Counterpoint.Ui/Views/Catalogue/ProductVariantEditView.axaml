<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Counterpoint.Ui.ViewModels.Catalogue"
             xmlns:controls="using:Counterpoint.Ui.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="420" d:DesignHeight="220"
             x:Class="Counterpoint.Ui.Views.Catalogue.ProductVariantEditView"
             x:DataType="vm:ProductVariantEditViewModel">

  <!-- Task P3-T15 (SRS FR-2.6, UI-05, UI-06, UI-14, UI-15, AC-22, AC-23), built from the P3-T12 LabeledField family. -->
  <StackPanel Spacing="12">
    <controls:LabeledTextField Name="SkuField" Label="SKU" Text="{Binding Sku}" />
    <controls:LabeledTextField Name="AttributesField" Label="Attributes" Watermark="attribute=value; attribute=value" Text="{Binding AttributesText}" />
    <controls:LabeledNumericField Name="PriceField" Label="Price" Text="{Binding PriceText}" />
  </StackPanel>

</UserControl>
