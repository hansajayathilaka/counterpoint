<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Counterpoint.Ui.ViewModels.Catalogue"
             xmlns:controls="using:Counterpoint.Ui.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="420" d:DesignHeight="380"
             x:Class="Counterpoint.Ui.Views.Catalogue.CustomerEditView"
             x:DataType="vm:CustomerEditViewModel">

  <!--
    Task P3-T15 (SRS UI-05, UI-06, UI-14, UI-15, AC-22, AC-23), built from the P3-T12 LabeledField
    family: the five watermark-only fields (name, phone, address, tax number, credit limit) that
    task P3-T12's ViewLabelInspectorTests used as the "still unconverted" fixture are gone.
  -->
  <StackPanel Spacing="12">
    <controls:LabeledTextField Name="NameField" Label="Customer name" Text="{Binding Name}" />
    <controls:LabeledTextField Name="PhoneField" Label="Phone" Text="{Binding Phone}" />
    <controls:LabeledTextField Name="AddressField" Label="Address" Text="{Binding Address}" />
    <controls:LabeledTextField Name="TaxNoField" Label="Tax number" Text="{Binding TaxNo}" />
    <controls:LabeledCheckBoxField Name="TradeField" CheckBoxLabel="Trade customer" IsChecked="{Binding IsTrade}" />
    <controls:LabeledNumericField Name="CreditLimitField" Label="Credit limit" Text="{Binding CreditLimitText}" />
  </StackPanel>

</UserControl>
