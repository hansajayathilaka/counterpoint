<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Counterpoint.Ui.ViewModels.Catalogue"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="860" d:DesignHeight="560"
             x:Class="Counterpoint.Ui.Views.Catalogue.CategoryTabView"
             x:DataType="vm:CategoryTabViewModel">

  <!-- FR-2.20: two levels only, enforced by the Application layer and the trg_category_two_levels_* backstop. -->
  <DockPanel Margin="12">

    <TextBlock DockPanel.Dock="Bottom" Margin="0,8,0,0" TextWrapping="Wrap" Text="{Binding Status}" />

    <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0" Spacing="6">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Content="_New" Command="{Binding NewCommand}" IsEnabled="{Binding !Busy}" />
        <Button Content="Turn on / off" Command="{Binding ToggleActiveCommand}" IsEnabled="{Binding !Busy}" />
        <Button Content="Delete" Command="{Binding DeleteCommand}" IsEnabled="{Binding !Busy}" />
      </StackPanel>
      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBox Width="220" Watermark="Category name" Text="{Binding Name}">
          <TextBox.KeyBindings>
            <KeyBinding Gesture="Enter" Command="{Binding SaveCommand}" />
          </TextBox.KeyBindings>
        </TextBox>
        <ComboBox Width="220"
                  ItemsSource="{Binding ParentOptions}"
                  SelectedItem="{Binding SelectedParent}" />
        <Button Content="_Save" Command="{Binding SaveCommand}" IsEnabled="{Binding !Busy}" />
      </StackPanel>
    </StackPanel>

    <ListBox ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}">
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="vm:CategoryRowViewModel">
          <Grid ColumnDefinitions="240,240,90">
            <TextBlock Grid.Column="0" Text="{Binding Name}" />
            <TextBlock Grid.Column="1" Text="{Binding ParentText}" />
            <TextBlock Grid.Column="2" Text="{Binding StateText}" />
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

  </DockPanel>

</UserControl>
