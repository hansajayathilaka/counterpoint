<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Counterpoint.Ui.ViewModels.Catalogue"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="700"
             x:Class="Counterpoint.Ui.Views.Catalogue.ProductTabView"
             x:DataType="vm:ProductTabViewModel">

  <!--
    The product editor (SRS FR-2.1-FR-2.8): the product master on the left, a variant grid, a
    unit-of-measure grid and the variant matrix generator on the right, all acting on whichever
    product is selected in the list. Owner only - not by anything here, but by
    [RequiresRole(Role.Owner)] on IProductMaintenance (SRS NFR-S2, AC-17).
  -->
  <Grid Margin="12" ColumnDefinitions="360,*" RowDefinitions="*,Auto">

    <!-- Product list -->
    <ListBox Grid.Row="0" Grid.Column="0" Margin="0,0,8,0"
              ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}">
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="vm:ProductRowViewModel">
          <Grid ColumnDefinitions="100,*,60,70">
            <TextBlock Grid.Column="0" Text="{Binding Code}" />
            <TextBlock Grid.Column="1" Text="{Binding Name}" />
            <TextBlock Grid.Column="2" Text="{Binding BaseUomSymbol}" />
            <TextBlock Grid.Column="3" Text="{Binding StateText}" />
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <!-- Product editor + variant/unit/matrix panels -->
    <ScrollViewer Grid.Row="0" Grid.Column="1">
      <StackPanel Spacing="10">

        <!-- Product master fields -->
        <StackPanel Spacing="6">
          <WrapPanel>
            <TextBox Width="140" Margin="0,0,8,4" Watermark="Code" Text="{Binding Code}" />
            <TextBox Width="220" Margin="0,0,8,4" Watermark="Name" Text="{Binding Name}" />
            <TextBox Width="180" Margin="0,0,8,4" Watermark="Alternate name" Text="{Binding NameAlt}" />
          </WrapPanel>
          <WrapPanel>
            <ComboBox Width="160" Margin="0,0,8,4" ItemsSource="{Binding CategoryOptions}" SelectedItem="{Binding SelectedCategory}" />
            <ComboBox Width="160" Margin="0,0,8,4" ItemsSource="{Binding BrandOptions}" SelectedItem="{Binding SelectedBrand}" />
            <ComboBox Width="180" Margin="0,0,8,4"
                      ItemsSource="{Binding BaseUomOptions}" SelectedItem="{Binding SelectedBaseUom}"
                      IsEnabled="{Binding BaseUomEditable}" />
            <ComboBox Width="200" Margin="0,0,8,4" ItemsSource="{Binding TypeLabels}" SelectedItem="{Binding SelectedTypeLabel}" />
            <ComboBox Width="160" Margin="0,0,8,4" ItemsSource="{Binding TaxClassOptions}" SelectedItem="{Binding SelectedTaxClass}" />
          </WrapPanel>
          <WrapPanel>
            <TextBox Width="120" Margin="0,0,8,4" Watermark="Location" Text="{Binding Location}" />
            <TextBox Width="120" Margin="0,0,8,4" Watermark="Warranty days" Text="{Binding WarrantyDaysText}" />
            <CheckBox Margin="0,0,8,4" Content="Non-returnable" IsChecked="{Binding NonReturnable}" />
            <TextBox Width="260" Margin="0,0,8,4" Watermark="Notes" Text="{Binding Notes}" />
          </WrapPanel>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="_New product" Command="{Binding NewCommand}" IsEnabled="{Binding !Busy}" />
            <Button Content="_Save product" Command="{Binding SaveCommand}" IsEnabled="{Binding !Busy}" />
            <Button Content="Turn on / off" Command="{Binding ToggleActiveCommand}" IsEnabled="{Binding !Busy}" />
          </StackPanel>
        </StackPanel>

        <TabControl>

          <!-- Variant grid (FR-2.6) -->
          <TabItem Header="Variants">
            <StackPanel Spacing="6" Margin="0,8,0,0">
              <WrapPanel>
                <TextBox Width="180" Margin="0,0,8,4" Watermark="SKU" Text="{Binding VariantSku}" />
                <TextBox Width="240" Margin="0,0,8,4" Watermark="attribute=value; attribute=value" Text="{Binding VariantAttributesText}" />
                <TextBox Width="100" Margin="0,0,8,4" Watermark="Price" Text="{Binding VariantPriceText}" />
              </WrapPanel>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="New variant" Command="{Binding NewVariantCommand}" IsEnabled="{Binding !Busy}" />
                <Button Content="Save variant" Command="{Binding SaveVariantCommand}" IsEnabled="{Binding !Busy}" />
                <Button Content="Turn on / off" Command="{Binding ToggleVariantActiveCommand}" IsEnabled="{Binding !Busy}" />
              </StackPanel>
              <ListBox Height="200" ItemsSource="{Binding Variants}" SelectedItem="{Binding SelectedVariant}">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:ProductVariantRowViewModel">
                    <Grid ColumnDefinitions="140,*,80,60">
                      <TextBlock Grid.Column="0" Text="{Binding Sku}" />
                      <TextBlock Grid.Column="1" Text="{Binding AttributesText}" />
                      <TextBlock Grid.Column="2" Text="{Binding PriceText}" />
                      <TextBlock Grid.Column="3" Text="{Binding StateText}" />
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </StackPanel>
          </TabItem>

          <!-- Unit-of-measure grid (FR-2.4, FR-2.5) -->
          <TabItem Header="Units">
            <StackPanel Spacing="6" Margin="0,8,0,0">
              <WrapPanel>
                <ComboBox Width="180" Margin="0,0,8,4" ItemsSource="{Binding AddableUomOptions}" SelectedItem="{Binding SelectedUomToAdd}" />
                <TextBox Width="100" Margin="0,0,8,4" Watermark="Factor (base units)" Text="{Binding UomFactorText}" />
                <TextBox Width="100" Margin="0,0,8,4" Watermark="Selling price (optional)" Text="{Binding UomSellingPriceText}" />
              </WrapPanel>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Add unit" Command="{Binding AddUomOptionCommand}" IsEnabled="{Binding !Busy}" />
                <Button Content="Update selected" Command="{Binding UpdateUomOptionCommand}" IsEnabled="{Binding !Busy}" />
                <Button Content="Remove selected" Command="{Binding RemoveUomOptionCommand}" IsEnabled="{Binding !Busy}" />
              </StackPanel>
              <ListBox Height="200" ItemsSource="{Binding UomOptions}" SelectedItem="{Binding SelectedUomOption}">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:ProductUomOptionRowViewModel">
                    <Grid ColumnDefinitions="100,100,120,80">
                      <TextBlock Grid.Column="0" Text="{Binding UomSymbol}" />
                      <TextBlock Grid.Column="1" Text="{Binding FactorText}" />
                      <TextBlock Grid.Column="2" Text="{Binding SellingPriceText}" />
                      <TextBlock Grid.Column="3" Text="{Binding StateText}" />
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </StackPanel>
          </TabItem>

          <!-- Variant matrix generator: preview before commit (FR-2.6) -->
          <TabItem Header="Generate variants">
            <StackPanel Spacing="6" Margin="0,8,0,0">
              <TextBlock Text="One axis per line: name: value1, value2, value3" />
              <TextBox Height="90" AcceptsReturn="True" Watermark="length: 25mm, 32mm, 40mm" Text="{Binding MatrixAxesText}" />
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBox Width="100" Watermark="Default price" Text="{Binding MatrixDefaultPriceText}" />
                <Button Content="Preview" Command="{Binding PreviewMatrixCommand}" IsEnabled="{Binding !Busy}" />
                <Button Content="Commit" Command="{Binding CommitMatrixCommand}" IsEnabled="{Binding !Busy}" />
              </StackPanel>
              <TextBlock TextWrapping="Wrap" Text="{Binding MatrixStatus}" />
              <ListBox Height="180" ItemsSource="{Binding MatrixPreview}" />
            </StackPanel>
          </TabItem>

        </TabControl>

      </StackPanel>
    </ScrollViewer>

    <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,8,0,0" TextWrapping="Wrap" Text="{Binding Status}" />

  </Grid>

</UserControl>
