<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Counterpoint.Ui.ViewModels.Catalogue"
             xmlns:controls="using:Counterpoint.Ui.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="700"
             x:Class="Counterpoint.Ui.Views.Catalogue.ProductTabView"
             x:DataType="vm:ProductTabViewModel">

  <!--
    The product editor (SRS FR-2.1-FR-2.8): the product list on the left, a variant grid, a
    unit-of-measure grid and the variant matrix generator on the right, all acting on whichever
    product is selected in the list. Owner only - not by anything here, but by
    [RequiresRole(Role.Owner)] on IProductMaintenance (SRS NFR-S2, AC-17).

    Task P3-T15 (SRS UI-05, UI-06, UI-14, UI-15, AC-22, AC-23): the product master, variant and
    unit-of-measure inline forms are gone, replaced by New/Edit buttons that open the shared
    EditDialogWindow through IDialogService, each with its own small content view built from the
    P3-T12 LabeledField family. The variant matrix generator is not master-data create/edit/delete
    - it is a preview-then-commit tool (SRS FR-2.6) - so its own free-text fields are converted to
    LabeledField in place rather than moved into a dialog.
  -->
  <Grid Margin="12" ColumnDefinitions="360,*" RowDefinitions="*,Auto">

    <!-- Product list -->
    <DockPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,0">
      <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
        <Button Content="_New" Command="{Binding NewProductDialogCommand}" IsEnabled="{Binding !Busy}" />
        <Button Content="_Edit" Command="{Binding EditProductDialogCommand}" IsEnabled="{Binding !Busy}" />
        <Button Content="Turn on / off" Command="{Binding ToggleActiveCommand}" IsEnabled="{Binding !Busy}" />
      </StackPanel>
      <ListBox ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:ProductRowViewModel">
            <Grid ColumnDefinitions="100,*,60,70">
              <TextBlock Grid.Column="0" Text="{Binding Code}" />
              <TextBlock Grid.Column="1" Text="{Binding Name}" />
              <TextBlock Grid.Column="2" Text="{Binding BaseUomSymbol}" />
              <TextBlock Grid.Column="3" Text="{Binding StateText}" />
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </DockPanel>

    <!-- Variant/unit/matrix panels for whichever product is selected on the left -->
    <TabControl Grid.Row="0" Grid.Column="1">

      <!-- Variant grid (FR-2.6) -->
      <TabItem Header="Variants">
        <StackPanel Spacing="6" Margin="0,8,0,0">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="_New variant" Command="{Binding NewVariantDialogCommand}" IsEnabled="{Binding !Busy}" />
            <Button Content="_Edit variant" Command="{Binding EditVariantDialogCommand}" IsEnabled="{Binding !Busy}" />
            <Button Content="Turn on / off" Command="{Binding ToggleVariantActiveCommand}" IsEnabled="{Binding !Busy}" />
          </StackPanel>
          <ListBox Height="220" ItemsSource="{Binding Variants}" SelectedItem="{Binding SelectedVariant}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:ProductVariantRowViewModel">
                <Grid ColumnDefinitions="140,*,80,60">
                  <TextBlock Grid.Column="0" Text="{Binding Sku}" />
                  <TextBlock Grid.Column="1" Text="{Binding AttributesText}" />
                  <TextBlock Grid.Column="2" Text="{Binding PriceText}" />
                  <TextBlock Grid.Column="3" Text="{Binding StateText}" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </StackPanel>
      </TabItem>

      <!-- Unit-of-measure grid (FR-2.4, FR-2.5) -->
      <TabItem Header="Units">
        <StackPanel Spacing="6" Margin="0,8,0,0">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="_Add unit" Command="{Binding AddUomOptionDialogCommand}" IsEnabled="{Binding !Busy}" />
            <Button Content="_Edit unit" Command="{Binding EditUomOptionDialogCommand}" IsEnabled="{Binding !Busy}" />
            <Button Content="_Remove unit" Command="{Binding RemoveUomOptionCommand}" IsEnabled="{Binding !Busy}" />
          </StackPanel>
          <ListBox Height="220" ItemsSource="{Binding UomOptions}" SelectedItem="{Binding SelectedUomOption}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:ProductUomOptionRowViewModel">
                <Grid ColumnDefinitions="100,100,120,80">
                  <TextBlock Grid.Column="0" Text="{Binding UomSymbol}" />
                  <TextBlock Grid.Column="1" Text="{Binding FactorText}" />
                  <TextBlock Grid.Column="2" Text="{Binding SellingPriceText}" />
                  <TextBlock Grid.Column="3" Text="{Binding StateText}" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </StackPanel>
      </TabItem>

      <!-- Variant matrix generator: preview before commit (FR-2.6) - not master-data create/edit/delete. -->
      <TabItem Header="Generate variants">
        <StackPanel Spacing="10" Margin="0,8,0,0">
          <TextBlock Text="One axis per line: name: value1, value2, value3" />
          <StackPanel Spacing="4">
            <TextBlock Name="MatrixAxesLabel" Text="Axes" Foreground="{DynamicResource SecondaryTextBrush}" />
            <TextBox Name="MatrixAxesBox" Height="90" AcceptsReturn="True" Watermark="length: 25mm, 32mm, 40mm" Text="{Binding MatrixAxesText}" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <controls:LabeledNumericField Name="MatrixDefaultPriceField" Label="Default price" Text="{Binding MatrixDefaultPriceText}" />
            <Button Content="Preview" Command="{Binding PreviewMatrixCommand}" IsEnabled="{Binding !Busy}" />
            <Button Content="Commit" Command="{Binding CommitMatrixCommand}" IsEnabled="{Binding !Busy}" />
          </StackPanel>
          <TextBlock TextWrapping="Wrap" Text="{Binding MatrixStatus}" />
          <ListBox Height="180" ItemsSource="{Binding MatrixPreview}" />
        </StackPanel>
      </TabItem>

    </TabControl>

    <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,8,0,0" TextWrapping="Wrap" Text="{Binding Status}" />

  </Grid>

</UserControl>
