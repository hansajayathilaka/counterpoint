<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Counterpoint.Ui.ViewModels"
        xmlns:views="using:Counterpoint.Ui.Views"
        xmlns:catalogue="using:Counterpoint.Ui.Views.Catalogue"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1040" d:DesignHeight="680"
        x:Class="Counterpoint.Ui.Views.BackOfficeShellWindow"
        x:DataType="vm:BackOfficeShellViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Width="1040" Height="680" MinWidth="800" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        Title="Counterpoint - Back office">

  <!--
    Task P3-T18 (SRS UI-11, UI-16, NFR-S2, AC-24), continuing task P3-T13. A persistent left
    NavRail (task P3-T18) plus a right content pane that swaps in place, replacing the old flat
    UniformGrid of five tiles. Catalogue is folded straight into this content pane rather than
    opening CatalogueWindow (retired by this task); Trading, People and System still open their
    own windows outright, exactly as before (P3-T13's own tile behaviour, unchanged). Same
    process, same IHost, same database, same ISession as the sales screen - only the window and
    what it shows differ (see BackOfficeShellViewModel's remarks). Every nav item is a courtesy:
    the screen or section it leads to re-checks the session's role at the Application layer
    regardless of whether this window ever rendered it.
  -->
  <DockPanel>

    <!-- The distinct colour accent UI-11 asks for - drawn from the same P3-T10 tokens the sales
         screen moved onto in P3-T14, not a second theme system. -->
    <Border DockPanel.Dock="Top" Height="6" Background="{DynamicResource AccentBrush}" />

    <!-- Its own status bar (SRS UI-09, UI-11) - a different background and different content
         from SalesWindow's, so the two screens cannot be mistaken for one another. -->
    <Border DockPanel.Dock="Top" Background="{DynamicResource PanelBackgroundBrush}" Padding="10,8">
      <StackPanel Orientation="Horizontal" Spacing="18">
        <TextBlock Text="BACK OFFICE" FontWeight="Bold" FontSize="17" Foreground="{DynamicResource PrimaryTextBrush}" />
        <TextBlock Text="{Binding StatusUserText}" Foreground="{DynamicResource PrimaryTextBrush}" />
        <TextBlock Text="{Binding StatusShiftText}" Foreground="{DynamicResource PrimaryTextBrush}" />
      </StackPanel>
    </Border>

    <Grid ColumnDefinitions="Auto,*">

      <views:NavRail Grid.Column="0" />

      <Grid Grid.Column="1" Margin="28">

        <!-- Overview: a placeholder pending P3-T20's real dashboard content (SRS UI-16). -->
        <StackPanel Spacing="8" IsVisible="{Binding !IsCatalogueSectionActive}">
          <TextBlock Text="Overview" FontSize="24" FontWeight="Bold"
                     Foreground="{DynamicResource PrimaryTextBrush}" />
          <TextBlock Text="The back-office dashboard lands here in a later task (P3-T20)."
                     Foreground="{DynamicResource SecondaryTextBrush}" />
        </StackPanel>

        <!-- Catalogue: folded into the content pane by this task (SRS FR-2.20, FR-2.21, FR-6). -->
        <catalogue:CatalogueSectionContent
            Catalogue="{Binding Catalogue}"
            SelectedSection="{Binding SelectedCatalogueSection}"
            IsVisible="{Binding IsCatalogueSectionActive}" />

      </Grid>

    </Grid>

  </DockPanel>

</Window>
