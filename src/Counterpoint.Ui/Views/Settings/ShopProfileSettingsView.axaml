<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Counterpoint.Ui.ViewModels.Settings"
             xmlns:controls="using:Counterpoint.Ui.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="620" d:DesignHeight="420"
             x:Class="Counterpoint.Ui.Views.Settings.ShopProfileSettingsView"
             x:DataType="vm:ShopProfileSettingsViewModel">

  <!--
    FR-10.1. Tab order is declaration order: every box is reachable without a mouse (UI-01). Task
    P3-T15 (SRS UI-06, UI-14, AC-22): every field is a persistent-label P3-T12 LabeledField, never
    a watermark standing in as the only label.
  -->
  <ScrollViewer>
    <StackPanel Margin="12" Spacing="12">

      <TextBlock Text="What prints at the top of every bill and report." TextWrapping="Wrap" />

      <controls:LabeledTextField Name="NameField" Label="Shop name" Text="{Binding Name}" />
      <controls:LabeledTextField Name="AddressLine1Field" Label="Address, first line" Text="{Binding AddressLine1}" />
      <controls:LabeledTextField Name="AddressLine2Field" Label="Address, second line" Text="{Binding AddressLine2}" />
      <controls:LabeledTextField Name="PhoneField" Label="Telephone" Text="{Binding Phone}" />
      <controls:LabeledTextField Name="EmailField" Label="Email" Text="{Binding Email}" />
      <controls:LabeledTextField Name="TaxRegistrationNumberField" Label="Tax registration number" Text="{Binding TaxRegistrationNumber}" />
      <controls:LabeledTextField Name="LogoPathField" Label="Logo file (leave empty for no logo)" Text="{Binding LogoPath}" />

    </StackPanel>
  </ScrollViewer>

</UserControl>
