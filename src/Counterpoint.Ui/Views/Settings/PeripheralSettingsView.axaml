<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Counterpoint.Ui.ViewModels.Settings"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="620" d:DesignHeight="420"
             x:Class="Counterpoint.Ui.Views.Settings.PeripheralSettingsView"
             x:DataType="vm:PeripheralSettingsViewModel">

  <!--
    FR-10.6. The printer is named, not discovered: listing print queues is a Windows call behind
    an interface this project may not reference, and the real names are read off the terminal
    when the hardware is commissioned.
  -->
  <ScrollViewer>
    <StackPanel Margin="12" Spacing="6">

      <TextBlock TextWrapping="Wrap" Text="The hardware on the counter." />

      <TextBlock Text="Receipt printer queue name" />
      <TextBox Width="320" HorizontalAlignment="Left" Text="{Binding ReceiptPrinterName}" />
      <TextBlock TextWrapping="Wrap" FontSize="12"
                 Text="Leave this empty to print to a file, which is what a development machine does." />

      <TextBlock Text="Paper width, in millimetres" />
      <TextBox Width="100" HorizontalAlignment="Left" Text="{Binding PaperWidthMm}" />

      <TextBlock Text="Copies of each bill" />
      <TextBox Width="100" HorizontalAlignment="Left" Text="{Binding ReceiptCopies}" />

      <TextBlock Text="Label printer queue name" />
      <TextBox Width="320" HorizontalAlignment="Left" Text="{Binding LabelPrinterName}" />

      <CheckBox Content="Open the cash drawer on a cash sale"
                IsChecked="{Binding OpenDrawerOnCashSale}" />

      <TextBlock Text="Drawer kick-out pin (2 or 5)" />
      <TextBox Width="80" HorizontalAlignment="Left" Text="{Binding DrawerKickPin}" />

      <TextBlock Text="What the scanner sends at the end of a scan" />
      <ComboBox Width="360" HorizontalAlignment="Left"
                ItemsSource="{Binding ScannerSuffixChoices}"
                SelectedItem="{Binding ScannerSuffixChoice}" />

      <TextBlock Text="Shortest input treated as a scan" />
      <TextBox Width="80" HorizontalAlignment="Left" Text="{Binding ScannerMinimumLength}" />

      <CheckBox Content="A weighing scale is connected" IsChecked="{Binding ScaleEnabled}" />

      <TextBlock Text="Scale serial port" />
      <TextBox Width="140" HorizontalAlignment="Left" Text="{Binding ScalePort}" />

      <TextBlock Text="Scale baud rate" />
      <TextBox Width="140" HorizontalAlignment="Left" Text="{Binding ScaleBaudRate}" />

    </StackPanel>
  </ScrollViewer>

</UserControl>
