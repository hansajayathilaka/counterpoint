<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Counterpoint.Ui.ViewModels.Settings"
             xmlns:controls="using:Counterpoint.Ui.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="620" d:DesignHeight="420"
             x:Class="Counterpoint.Ui.Views.Settings.PeripheralSettingsView"
             x:DataType="vm:PeripheralSettingsViewModel">

  <!--
    FR-10.6. The printer is named, not discovered: listing print queues is a Windows call behind
    an interface this project may not reference, and the real names are read off the terminal
    when the hardware is commissioned. Task P3-T15 (SRS UI-06, UI-14, AC-22): every field is a
    persistent-label P3-T12 LabeledField.
  -->
  <ScrollViewer>
    <StackPanel Margin="12" Spacing="12">

      <TextBlock TextWrapping="Wrap" Text="The hardware on the counter." />

      <StackPanel Spacing="4">
        <controls:LabeledTextField Name="ReceiptPrinterNameField" Width="320" HorizontalAlignment="Left"
                                    Label="Receipt printer queue name" Text="{Binding ReceiptPrinterName}" />
        <TextBlock TextWrapping="Wrap" FontSize="12"
                   Text="Leave this empty to print to a file, which is what a development machine does." />
      </StackPanel>

      <controls:LabeledNumericField Name="PaperWidthMmField" Width="100" HorizontalAlignment="Left"
                                     Label="Paper width, in millimetres" Text="{Binding PaperWidthMm}" />

      <controls:LabeledNumericField Name="ReceiptCopiesField" Width="100" HorizontalAlignment="Left"
                                     Label="Copies of each bill" Text="{Binding ReceiptCopies}" />

      <controls:LabeledTextField Name="LabelPrinterNameField" Width="320" HorizontalAlignment="Left"
                                  Label="Label printer queue name" Text="{Binding LabelPrinterName}" />

      <controls:LabeledCheckBoxField Name="OpenDrawerOnCashSaleField"
                                      CheckBoxLabel="Open the cash drawer on a cash sale"
                                      IsChecked="{Binding OpenDrawerOnCashSale}" />

      <controls:LabeledNumericField Name="DrawerKickPinField" Width="80" HorizontalAlignment="Left"
                                     Label="Drawer kick-out pin (2 or 5)" Text="{Binding DrawerKickPin}" />

      <controls:LabeledComboField Name="ScannerSuffixField" Width="360" HorizontalAlignment="Left"
                                   Label="What the scanner sends at the end of a scan"
                                   ItemsSource="{Binding ScannerSuffixChoices}"
                                   SelectedItem="{Binding ScannerSuffixChoice}" />

      <controls:LabeledNumericField Name="ScannerMinimumLengthField" Width="80" HorizontalAlignment="Left"
                                     Label="Shortest input treated as a scan" Text="{Binding ScannerMinimumLength}" />

      <controls:LabeledCheckBoxField Name="ScaleEnabledField"
                                      CheckBoxLabel="A weighing scale is connected"
                                      IsChecked="{Binding ScaleEnabled}" />

      <controls:LabeledTextField Name="ScalePortField" Width="140" HorizontalAlignment="Left"
                                  Label="Scale serial port" Text="{Binding ScalePort}" />

      <controls:LabeledNumericField Name="ScaleBaudRateField" Width="140" HorizontalAlignment="Left"
                                     Label="Scale baud rate" Text="{Binding ScaleBaudRate}" />

    </StackPanel>
  </ScrollViewer>

</UserControl>
