<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Counterpoint.Ui.ViewModels.Settings"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="560" d:DesignHeight="480"
        x:Class="Counterpoint.Ui.Views.Settings.RestoreWizardWindow"
        x:DataType="vm:RestoreWizardViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Width="560" Height="480"
        WindowStartupLocation="CenterOwner"
        Title="Counterpoint - restore from backup"
        CanResize="False">

  <!--
    Guided restore (SRS FR-11.12, FR-11.13). Four steps, in order: choose a file, check it (no
    passphrase needed), type the passphrase and the exact confirmation phrase, then restore. Every
    box below the "Check" button is disabled until the checksum has verified, so there is no path
    through this screen that skips a step.
  -->
  <StackPanel Margin="16" Spacing="8">

    <TextBlock TextWrapping="Wrap" FontWeight="Bold"
               Text="Restoring replaces this till's data with an earlier backup. The current database is backed up first, automatically." />

    <TextBlock Text="Backup file (local folder or a USB drive)" />
    <DockPanel>
      <Button DockPanel.Dock="Right" Margin="8,0,0,0" Content="_Browse..." Click="OnBrowseFileClick" />
      <TextBox Text="{Binding FilePath}" />
    </DockPanel>

    <Button Content="_Check backup" Command="{Binding CheckBackupCommand}" IsEnabled="{Binding !Busy}" />

    <TextBlock TextWrapping="Wrap" Text="{Binding PreviewText}" IsVisible="{Binding HasVerifiedPreview}" />

    <StackPanel IsEnabled="{Binding HasVerifiedPreview}" Spacing="8" Margin="0,8,0,0">

      <TextBlock Text="Passphrase this backup was encrypted with" />
      <TextBox PasswordChar="•" Text="{Binding Passphrase}" />

      <TextBlock Text="{Binding RequiredConfirmationPhrase, StringFormat='Type {0} exactly to confirm'}" />
      <TextBox Text="{Binding TypedConfirmation}" />

      <Button Content="_Restore" Command="{Binding RestoreCommand}" />

    </StackPanel>

    <TextBlock TextWrapping="Wrap" Text="{Binding Status}" />

    <Button Content="Close Counterpoint now" Command="{Binding CloseNowCommand}" IsVisible="{Binding RestoreCompleted}" />

  </StackPanel>

</Window>
