<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Counterpoint.Ui.ViewModels.Settings"
             xmlns:controls="using:Counterpoint.Ui.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="620" d:DesignHeight="420"
             x:Class="Counterpoint.Ui.Views.Settings.TaxSettingsView"
             x:DataType="vm:TaxSettingsViewModel">

  <!--
    FR-10.3. No rate is written into this file; the shop's regime is data, not code (Q-02). Task
    P3-T15 (SRS UI-06, UI-14, AC-22): every field is a persistent-label P3-T12 LabeledField.
  -->
  <ScrollViewer>
    <StackPanel Margin="12" Spacing="12">

      <TextBlock TextWrapping="Wrap"
                 Text="How the shop charges tax, and what tax is called on the bill." />

      <controls:LabeledCheckBoxField Name="PricesIncludeTaxField"
                                      CheckBoxLabel="Catalogue prices already include tax"
                                      IsChecked="{Binding PricesIncludeTax}" />

      <controls:LabeledTextField Name="DefaultTaxClassNameField" Width="240" HorizontalAlignment="Left"
                                  Label="Default tax class for a new product" Text="{Binding DefaultTaxClassName}" />

      <controls:LabeledNumericField Name="DefaultTaxRateField" Width="120" HorizontalAlignment="Left"
                                     Label="Its rate, in percent" Text="{Binding DefaultTaxRate}" />

      <controls:LabeledTextField Name="TaxLabelField" Width="240" HorizontalAlignment="Left"
                                  Label="What tax is called on the bill" Text="{Binding TaxLabel}" />

      <TextBlock Margin="0,12,0,0" TextWrapping="Wrap"
                 Text="Further tax classes are created during first-run setup. Renaming and adding to them from here arrives with the reference-data screens." />

    </StackPanel>
  </ScrollViewer>

</UserControl>
