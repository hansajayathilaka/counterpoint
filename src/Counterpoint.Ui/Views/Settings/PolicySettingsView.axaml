<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Counterpoint.Ui.ViewModels.Settings"
             xmlns:controls="using:Counterpoint.Ui.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="620" d:DesignHeight="420"
             x:Class="Counterpoint.Ui.Views.Settings.PolicySettingsView"
             x:DataType="vm:PolicySettingsViewModel">

  <!--
    FR-10.5. Every later feature reads its limits from here. The amount and the three rates are a
    Money and three Percentages behind the boxes; nothing on this screen rounds anything. Task
    P3-T15 (SRS UI-06, UI-14, AC-22): every field is a persistent-label P3-T12 LabeledField.
  -->
  <ScrollViewer>
    <StackPanel Margin="12" Spacing="12">

      <TextBlock TextWrapping="Wrap"
                 Text="Returns, refunds, discount ceilings and what a sale does when stock runs out." />

      <controls:LabeledNumericField Name="ReturnWindowDaysField" Width="100" HorizontalAlignment="Left"
                                     Label="Return window, in days" Text="{Binding ReturnWindowDays}" />

      <controls:LabeledCheckBoxField Name="AllowUnlinkedReturnsField"
                                      CheckBoxLabel="Accept a return without the bill it came from"
                                      IsChecked="{Binding AllowUnlinkedReturns}" />

      <controls:LabeledComboField Name="DefaultRefundMethodField" Width="280" HorizontalAlignment="Left"
                                   Label="Refund paid as, unless the cashier changes it"
                                   ItemsSource="{Binding DefaultRefundMethodChoices}"
                                   SelectedItem="{Binding DefaultRefundMethodChoice}" />

      <controls:LabeledNumericField Name="CashRefundLimitField" Width="160" HorizontalAlignment="Left"
                                     Label="Most that may be refunded in cash on one return (0 = no limit)"
                                     Text="{Binding CashRefundLimit}" />

      <controls:LabeledNumericField Name="MaxLineDiscountRateField" Width="120" HorizontalAlignment="Left"
                                     Label="Cashier's discount limit on one line, in percent"
                                     Text="{Binding MaxLineDiscountRate}" />

      <controls:LabeledNumericField Name="MaxBillDiscountRateField" Width="120" HorizontalAlignment="Left"
                                     Label="Cashier's discount limit on the whole bill, in percent"
                                     Text="{Binding MaxBillDiscountRate}" />

      <controls:LabeledComboField Name="NegativeStockField" Width="320" HorizontalAlignment="Left"
                                   Label="When a sale would take the balance below zero"
                                   ItemsSource="{Binding NegativeStockChoices}"
                                   SelectedItem="{Binding NegativeStockChoice}" />

      <controls:LabeledNumericField Name="RestockingFeeRateField" Width="120" HorizontalAlignment="Left"
                                     Label="Restocking fee kept on a return, in percent"
                                     Text="{Binding RestockingFeeRate}" />

      <controls:LabeledCheckBoxField Name="CombineRepeatScansField"
                                      CheckBoxLabel="Scanning the same code again increases that line's quantity, instead of adding a second line"
                                      IsChecked="{Binding CombineRepeatScans}" />

    </StackPanel>
  </ScrollViewer>

</UserControl>
