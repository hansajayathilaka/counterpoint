<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Counterpoint.Ui.ViewModels.Settings"
             xmlns:controls="using:Counterpoint.Ui.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="620" d:DesignHeight="140"
             x:Class="Counterpoint.Ui.Views.Settings.DocumentNumberingView"
             x:DataType="vm:DocumentNumberingViewModel">

  <!--
    FR-10.4. One series: what it is called, what its numbers look like, where it starts. Task
    P3-T15 (SRS UI-06, UI-14, AC-22): every field is a persistent-label P3-T12 LabeledField.
  -->
  <StackPanel Spacing="6">

    <TextBlock FontSize="16" Text="{Binding Title}" />

    <StackPanel Orientation="Horizontal" Spacing="16">
      <controls:LabeledTextField Name="PrefixField" Width="120" Label="Prefix" Text="{Binding Prefix}" />
      <controls:LabeledTextField Name="PatternField" Width="260" Label="Pattern" Text="{Binding Pattern}" />
      <controls:LabeledNumericField Name="StartingNumberField" Width="120"
                                     Label="Starts at" Text="{Binding StartingNumber}"
                                     IsEnabled="{Binding IsStartingNumberEditable}"
                                     ToolTip.Tip="Set once during first-run setup; a document number, once issued, is never renumbered."
                                     ToolTip.ShowOnDisabled="True" />
    </StackPanel>

    <!-- Explains the disabled "Starts at" box without requiring a hover, for the general
         settings screen (NumberingSettingsViewModel) - the first-run wizard never shows this. -->
    <TextBlock IsVisible="{Binding !IsStartingNumberEditable}"
               FontSize="12" Opacity="0.7" Margin="0,2,0,0"
               Text="Set once during first-run setup; a document number, once issued, is never renumbered." />

  </StackPanel>

</UserControl>
