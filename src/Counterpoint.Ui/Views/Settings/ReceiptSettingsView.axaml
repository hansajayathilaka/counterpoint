<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Counterpoint.Ui.ViewModels.Settings"
             xmlns:controls="using:Counterpoint.Ui.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="620" d:DesignHeight="420"
             x:Class="Counterpoint.Ui.Views.Settings.ReceiptSettingsView"
             x:DataType="vm:ReceiptSettingsViewModel">

  <!--
    FR-10.8. The policy paragraph is wrapped to the paper width by the renderer, not here. Task
    P3-T15 (SRS UI-06, UI-14, AC-22): the two single-line fields are P3-T12 LabeledTextFields; the
    two multi-line boxes (AcceptsReturn, a taller box, and - for the template - a fixed-width
    font) are what the family cannot express, so they keep a plain TextBox/TextBlock pair wired to
    AutomationProperties.LabeledBy in the code-behind, the same pattern ImportTabView/
    ProductTabView use elsewhere.
  -->
  <ScrollViewer>
    <StackPanel Margin="12" Spacing="12">

      <TextBlock TextWrapping="Wrap"
                 Text="The words the shop puts on a bill, and which optional fields print." />

      <controls:LabeledTextField Name="HeaderTextField" Label="Header line, under the shop's address" Text="{Binding HeaderText}" />

      <controls:LabeledTextField Name="FooterTextField" Label="Footer line" Text="{Binding FooterText}" />

      <StackPanel Spacing="4">
        <TextBlock Name="PolicyTextLabel" Text="Return policy paragraph"
                   Foreground="{DynamicResource SecondaryTextBrush}" />
        <TextBox Name="PolicyTextBox" Height="80" AcceptsReturn="True" TextWrapping="Wrap"
                 Text="{Binding PolicyText}" />
      </StackPanel>

      <TextBlock Margin="0,8,0,0" FontSize="16" Text="What prints on the bill" />

      <controls:LabeledCheckBoxField Name="ShowLogoField" CheckBoxLabel="The shop's logo" IsChecked="{Binding ShowLogo}" />
      <controls:LabeledCheckBoxField Name="ShowBillBarcodeField" CheckBoxLabel="The bill number as a barcode" IsChecked="{Binding ShowBillBarcode}" />
      <controls:LabeledCheckBoxField Name="ShowCashierNameField" CheckBoxLabel="The cashier's name" IsChecked="{Binding ShowCashierName}" />
      <controls:LabeledCheckBoxField Name="ShowCustomerNameField" CheckBoxLabel="The customer's name" IsChecked="{Binding ShowCustomerName}" />
      <controls:LabeledCheckBoxField Name="ShowItemAndUnitCountField" CheckBoxLabel="The items and units tally" IsChecked="{Binding ShowItemAndUnitCount}" />
      <controls:LabeledCheckBoxField Name="ShowTaxSummaryField" CheckBoxLabel="The tax summary" IsChecked="{Binding ShowTaxSummary}" />
      <controls:LabeledCheckBoxField Name="ShowTaxableValueField" CheckBoxLabel="The taxable value" IsChecked="{Binding ShowTaxableValue}" />
      <controls:LabeledCheckBoxField Name="ShowTaxRegistrationNumberField" CheckBoxLabel="The shop's tax registration number"
                                      IsChecked="{Binding ShowTaxRegistrationNumber}" />

      <!-- FR-7.3, NFR-M1: the layout itself, owner-editable without a code change. Blank means
           "use the shipped default" (the §10.1 specimen). -->
      <TextBlock Margin="0,8,0,0" FontSize="16" Text="Bill layout template (advanced)" />
      <StackPanel Spacing="4">
        <TextBlock Name="TemplateTextLabel" Text="Bill layout template text"
                   Foreground="{DynamicResource SecondaryTextBrush}" />
        <TextBox Name="TemplateTextBox" Height="140" AcceptsReturn="True" FontFamily="monospace" TextWrapping="NoWrap"
                 Text="{Binding TemplateText}" />
      </StackPanel>

      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Content="_Preview" Command="{Binding PreviewCommand}" />
        <TextBlock VerticalAlignment="Center"
                   Text="Renders to this box only - nothing is queued or printed." />
      </StackPanel>

      <Border BorderThickness="1" Padding="8">
        <ScrollViewer Height="220">
          <TextBlock TextWrapping="Wrap" FontFamily="monospace" Text="{Binding PreviewText}" />
        </ScrollViewer>
      </Border>

    </StackPanel>
  </ScrollViewer>

</UserControl>
