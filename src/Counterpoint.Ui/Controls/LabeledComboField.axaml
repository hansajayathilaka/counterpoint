<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Avalonia.Data.Converters;assembly=Avalonia.Base"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="260" d:DesignHeight="70"
             x:Class="Counterpoint.Ui.Controls.LabeledComboField"
             x:Name="Root">

  <!-- Task P3-T12 (SRS UI-06, UI-14, AC-22): the combo/picker variant of the field family. -->
  <StackPanel Spacing="4">
    <TextBlock Name="LabelBlock"
               Text="{Binding #Root.Label}"
               Foreground="{DynamicResource SecondaryTextBrush}" />
    <ComboBox Name="InputCombo"
              ItemsSource="{Binding #Root.ItemsSource}"
              SelectedItem="{Binding #Root.SelectedItem, Mode=TwoWay}"
              HorizontalAlignment="Stretch" />
    <TextBlock Text="{Binding #Root.ValidationMessage}"
               Foreground="{DynamicResource WarningBrush}"
               IsVisible="{Binding #Root.ValidationMessage, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" />
  </StackPanel>

</UserControl>
