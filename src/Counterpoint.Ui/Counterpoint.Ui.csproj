<Project Sdk="Microsoft.NET.Sdk">

  <!--
    A class library, not the executable. The composition root lives in Counterpoint.App,
    which is the only project allowed to reference both this and Infrastructure/Devices:
    Counterpoint.Ui itself may reference Application and Domain ONLY (CLAUDE.md
    "Project boundaries"), so it cannot be the project that wires them together.
  -->
  <PropertyGroup>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <BuiltInComInteropSupport>false</BuiltInComInteropSupport>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <!-- Versions come from Directory.Packages.props. -->
  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
  </ItemGroup>

  <!--
    Counterpoint.Ui may reference Application and Domain ONLY.
    Never Infrastructure, Devices, Reporting or Backup - the composition root wires
    those in by interface. See CLAUDE.md "Project boundaries"; enforced by
    tests/Counterpoint.Domain.Tests/ArchitectureTests.cs.
  -->
  <ItemGroup>
    <ProjectReference Include="..\Counterpoint.Application\Counterpoint.Application.csproj" />
    <ProjectReference Include="..\Counterpoint.Domain\Counterpoint.Domain.csproj" />
  </ItemGroup>

</Project>
