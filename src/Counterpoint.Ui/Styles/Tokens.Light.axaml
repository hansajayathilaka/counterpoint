<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    Task P3-T10 (SRS UI-13, NFR-U4). The Light half of the theme's semantic palette. Every value
    a screen needs comes from here or from Tokens.Dark.axaml, never from a hex literal typed into
    a view - App.axaml merges both as Avalonia's own Light/Dark theme dictionaries, so a
    DynamicResource lookup against one of these keys resolves to whichever half is active and
    re-resolves the instant Application.Current.RequestedThemeVariant changes, with no restart.

    Every key here is proven to meet WCAG AA's 4.5:1 minimum contrast for normal text against
    every background it is documented to sit on - see
    tests/Counterpoint.Domain.Tests/Ui/ThemeTokenContrastTests.cs, which computes the ratio from
    the colours below rather than trusting a screenshot. Change a colour here and that test is
    what proves the change did not quietly make a screen illegible.
  -->

  <!-- The plain window/page background most screens sit on. -->
  <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#FFFFFF" />

  <!--
    A raised surface: a side panel, a card, a dialog body. Distinct from the window background so
    a panel reads as a panel in either theme (the confirmed "side panel is not compatible with
    dark mode" defect this task exists to fix at the token level; P3-T14 retrofits the sales
    screen's own panel onto this key).
  -->
  <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#F3F4F6" />

  <!-- The border around a panel. Decorative chrome, not text - held to WCAG's 3:1 non-text
       threshold rather than the 4.5:1 text threshold the other keys are proven against. -->
  <SolidColorBrush x:Key="PanelBorderBrush" Color="#D1D5DB" />

  <!-- Body text: headings, labels, the words a cashier reads on every screen. -->
  <SolidColorBrush x:Key="PrimaryTextBrush" Color="#111827" />

  <!-- Secondary text: captions, hints, a SKU under a product name - present but deliberately
       quieter than PrimaryTextBrush, while still meeting 4.5:1. -->
  <SolidColorBrush x:Key="SecondaryTextBrush" Color="#4B5563" />

  <!-- The shop's own accent: a link, a focus ring, a "this is selected" stripe. -->
  <SolidColorBrush x:Key="AccentBrush" Color="#1D4ED8" />

  <!-- A warning or a negative figure - a bill discount, a stock-take shortfall. -->
  <SolidColorBrush x:Key="WarningBrush" Color="#B91C1C" />

  <!-- SRS UI-03: the running bill total must be the most prominent thing on the sales screen.
       This is the colour that makes it so, wherever a screen shows a grand total. -->
  <SolidColorBrush x:Key="TotalHighlightBrush" Color="#047857" />

  <!--
    Task P3-T17 (SRS UI-13, NFR-U4, NFR-M1). Extended semantic palette for the "UI redesign v2"
    back-office rail/dashboard/sales-refresh work (P3-T18-P3-T21). Strictly additive to the eight
    keys above - no rename, no removal, so every P3-T10-P3-T16 consumer keeps working unmodified.
    Proven against tests/Counterpoint.Domain.Tests/Ui/ThemeTokenContrastTests.cs exactly as the
    original eight are.
  -->

  <!-- A raised card/tile that sits on top of PanelBackgroundBrush or WindowBackgroundBrush - the
       dashboard's own summary tiles, for example. Distinct from PanelBackgroundBrush so a screen
       can nest a card inside a panel and still have the nesting read visually. -->
  <SolidColorBrush x:Key="SurfaceBackgroundBrush" Color="#FFFFFF" />

  <!-- A recessed well: a read-only field, a search box, a code-like display. Darker than the
       surface/panel/window it sits inside, the opposite direction from SurfaceBackgroundBrush. -->
  <SolidColorBrush x:Key="SunkenSurfaceBackgroundBrush" Color="#E5E7EB" />

  <!-- The least prominent text tier: timestamps, row counts, a muted caption - quieter than
       SecondaryTextBrush while still meeting WCAG AA 4.5:1 against WindowBackgroundBrush and
       PanelBackgroundBrush. -->
  <SolidColorBrush x:Key="TertiaryTextBrush" Color="#5F6673" />

  <!-- The shop's brand colour for the redesigned dashboard/rail chrome - distinct from
       AccentBrush (P3-T10's link/focus-ring/selection colour) so a future screen can use one for
       chrome and the other for interaction state without them fighting for the same hue. -->
  <SolidColorBrush x:Key="BrandBrush" Color="#2563EB" />

  <!-- BrandBrush's hover/pressed state - one step darker. -->
  <SolidColorBrush x:Key="BrandHoverBrush" Color="#1D4ED8" />

  <!-- A pale brand-tinted background for a selected or highlighted row/card, never used as text. -->
  <SolidColorBrush x:Key="BrandTintBrush" Color="#DBEAFE" />

  <!-- A positive/confirming figure or status - distinct from TotalHighlightBrush's specific "this
       is the bill total" job, for general success states the redesign introduces (a completed
       import, a healthy stock level). -->
  <SolidColorBrush x:Key="SuccessBrush" Color="#047857" />

  <!-- SuccessBrush's own pale tint background - SuccessBrush text on this background meets WCAG
       AA 4.5:1, proven by ThemeTokenContrastTests. -->
  <SolidColorBrush x:Key="SuccessTintBrush" Color="#D1FAE5" />

  <!-- A destructive action or hard failure - distinct from WarningBrush's "warning/negative
       figure" job, for the redesign's own delete/danger affordances. -->
  <SolidColorBrush x:Key="DangerBrush" Color="#B91C1C" />

  <!-- DangerBrush's own pale tint background - DangerBrush text on this background meets WCAG AA
       4.5:1, proven by ThemeTokenContrastTests. -->
  <SolidColorBrush x:Key="DangerTintBrush" Color="#FEE2E2" />

  <!--
    The back-office nav rail sub-palette (SRS UI-16, task P3-T18/P3-T19 consume it). A single
    fixed dark rail per the approved design, not a third theme variant - these five keys carry
    the exact same values in Tokens.Dark.axaml, proven identical by
    ThemeTokenContrastTests.UI_13_TheRailPaletteIsIdenticalInBothTokenFiles.
  -->
  <SolidColorBrush x:Key="RailBackgroundBrush" Color="#111827" />
  <SolidColorBrush x:Key="RailActiveBackgroundBrush" Color="#1D4ED8" />
  <SolidColorBrush x:Key="RailTextBrush" Color="#E5E7EB" />
  <SolidColorBrush x:Key="RailActiveTextBrush" Color="#FFFFFF" />
  <SolidColorBrush x:Key="RailMutedTextBrush" Color="#9CA3AF" />

  <!--
    Bundled display/body typefaces (SRS NFR-U5): embedded avares:// resources under
    Assets/Fonts/**, never a network font fetch. Manrope for display/headings/totals, IBM Plex
    Sans for body text. Both SIL OFL 1.1 - licence text committed alongside each font family's
    files; see docs/adr/0009-bundled-manrope-and-ibm-plex-sans-fonts.md. Identical in both token
    files, the same pattern as the rail palette above.
  -->
  <FontFamily x:Key="DisplayFontFamily">avares://Counterpoint.Ui/Assets/Fonts/Manrope#Manrope</FontFamily>
  <FontFamily x:Key="BodyFontFamily">avares://Counterpoint.Ui/Assets/Fonts/IBMPlexSans#IBM Plex Sans</FontFamily>

</ResourceDictionary>
